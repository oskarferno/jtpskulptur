---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found — JTP Skulptur" noindex>
  <div class="mx-auto flex min-h-[70svh] max-w-(--measure-content) flex-col items-center justify-center px-4 text-center sm:px-8">
    <p class="caption">404</p>
    <h1 class="font-display mt-4 text-3xl sm:text-5xl">Page not found</h1>
    <p class="mt-4 text-(--color-ink-soft)">The page you're looking for doesn't exist.</p>
    <div class="mt-10 flex gap-6 text-sm tracking-[0.04em] uppercase">
      <a href="/portfolio" class="border border-(--color-ink) px-6 py-2 hover:bg-(--color-ink) hover:text-(--color-paper)">
        Portfolio
      </a>
      <a href="/" class="border border-(--color-line) px-6 py-2 text-(--color-ink-soft) hover:border-(--color-ink) hover:text-(--color-ink)">
        Home
      </a>
    </div>
  </div>
</Layout>
