---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found — jtp.skulptur" noindex>
  <div class="mx-auto max-w-2xl px-6 py-24 text-center sm:px-8">
    <h1 class="font-display text-3xl">Page not found</h1>
    <p class="mt-4 text-(--color-ink-soft)">The page you're looking for doesn't exist.</p>
    <a href="/" class="mt-8 inline-block border border-(--color-ink) px-6 py-2 text-sm tracking-wide uppercase hover:bg-(--color-ink) hover:text-(--color-paper)">
      Back to Portfolio
    </a>
  </div>
</Layout>
