---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { getSupabaseClient } from '../../lib/supabase';
import { publicMediaUrl, scaledHeight } from '../../lib/media';

const supabase = getSupabaseClient();
const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

const { data: product } = await supabase
  .from('products')
  .select(
    `id, slug, name, description, short_description, price, currency, inventory, seo_title, seo_description,
     primary_media:primary_image_id (bucket, storage_path, alt_text, width, height),
     product_images (display_order, media:media_id (bucket, storage_path, alt_text, width, height))`
  )
  .eq('slug', slug)
  .eq('active', true)
  .single();

if (!product) {
  return Astro.redirect('/404');
}

const galleryImages = (product.product_images ?? []).sort((a, b) => a.display_order - b.display_order);
const title = product.seo_title ?? `${product.name} — Shop — JTP Skulptur`;
const description = product.seo_description ?? product.short_description ?? product.description ?? undefined;
const ogImage = product.primary_media
  ? publicMediaUrl(product.primary_media.bucket, product.primary_media.storage_path)
  : undefined;

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.short_description ?? product.description ?? undefined,
  image: ogImage,
  offers: {
    '@type': 'Offer',
    price: product.price,
    priceCurrency: product.currency,
    availability: product.inventory > 0 ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
  },
};
---

<Layout title={title} description={description} ogImage={ogImage} jsonLd={productJsonLd}>
  <article>
    {/* Same side-by-side treatment as artwork detail (portfolio/[slug].astro) — an uncropped
        portrait photo alone in a full-width band leaves most of the frame empty; pairing it
        with its own label instead makes that space intentional. Mobile/tablet just stack. */}
    <div class="lg:flex lg:min-h-[38rem] lg:items-stretch xl:min-h-[44rem]">
      {product.primary_media && (
        <div class="flex justify-center bg-(--color-paper-raised) lg:w-[60%] lg:flex-shrink-0">
          <Image
            src={publicMediaUrl(product.primary_media.bucket, product.primary_media.storage_path)}
            alt={product.primary_media.alt_text ?? product.name}
            width={1600}
            height={scaledHeight(1600, product.primary_media)}
            densities={[1, 2]}
            quality={80}
            fetchpriority="high"
            class="max-h-[85svh] w-auto max-w-full object-contain lg:h-full lg:max-h-none"
          />
        </div>
      )}

    <div class="px-4 py-12 sm:px-8 sm:py-16 max-lg:mx-auto max-lg:max-w-(--measure-content) lg:flex lg:w-[40%] lg:flex-shrink-0 lg:flex-col lg:justify-center lg:px-12 lg:py-0 xl:px-16">
      <h1 class="font-display text-3xl sm:text-4xl">{product.name}</h1>
      <p class="mt-3 text-lg text-(--color-ink-soft)">{product.price.toFixed(0)} {product.currency}</p>
      {product.short_description && <p class="mt-6 leading-relaxed text-(--color-ink-soft)">{product.short_description}</p>}
      {product.description && <p class="mt-6 leading-relaxed">{product.description}</p>}

      {product.inventory > 0 ? (
        <form id="add-to-cart-form" class="mt-10 flex items-center gap-4" data-product-id={product.id}>
          <label class="sr-only" for="quantity">Quantity</label>
          <select id="quantity" name="quantity" class="border border-(--color-line) bg-transparent px-3 py-2 text-sm">
            {Array.from({ length: Math.min(product.inventory, 10) }, (_, i) => i + 1).map((n) => (
              <option value={n}>{n}</option>
            ))}
          </select>
          <button
            type="submit"
            class="border border-(--color-ink) px-6 py-2 text-sm tracking-[0.04em] uppercase transition-colors hover:bg-(--color-ink) hover:text-(--color-paper)"
          >
            Add to cart
          </button>
        </form>
      ) : (
        <p class="mt-10 text-sm text-(--color-ink-faint) uppercase tracking-[0.04em]">Sold out</p>
      )}
      <p id="add-to-cart-status" role="status" class="mt-3 text-sm"></p>
    </div>
    </div>

    {galleryImages.length > 0 && (
      <div class="mx-auto max-w-(--measure-full) space-y-4 px-4 pb-16 sm:px-8">
        {galleryImages.map(({ media }) => media && (
          <figure>
            <Image
              src={publicMediaUrl(media.bucket, media.storage_path)}
              alt={media.alt_text ?? product.name}
              width={1400}
              height={scaledHeight(1400, media)}
              densities={[1, 1.5]}
              quality={80}
              loading="lazy"
              class="w-full bg-(--color-paper-raised) object-contain"
            />
          </figure>
        ))}
      </div>
    )}
  </article>

  <script>
    import { addToCart } from '../../lib/cart';

    const form = document.getElementById('add-to-cart-form') as HTMLFormElement | null;
    const status = document.getElementById('add-to-cart-status');

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const productId = form.dataset.productId;
      const quantity = Number(new FormData(form).get('quantity'));
      if (!productId || !Number.isInteger(quantity) || quantity < 1) return;
      addToCart('product', productId, quantity);
      if (status) status.textContent = 'Added to cart.';
    });
  </script>
</Layout>
