---
// Payment confirmation is never inferred from merely reaching this page —
// it's read back from our own `orders` row (kept in sync by the Stripe
// webhook), which only ever reaches payment_status='paid' after Stripe
// itself verified payment server-side. The session_id in the URL is just a
// lookup key, not proof of anything by itself.
import Layout from '../../layouts/Layout.astro';
import { getSupabaseServerClient } from '../../lib/supabase-server';

const sessionId = Astro.url.searchParams.get('session_id');
let order: { order_number: string; total: number; currency: string; payment_status: string } | null = null;

if (sessionId) {
  const admin = getSupabaseServerClient();
  const { data } = await admin
    .from('orders')
    .select('order_number, total, currency, payment_status')
    .eq('stripe_checkout_session_id', sessionId)
    .maybeSingle();
  order = data;
}
---

<Layout title="Order confirmed — JTP Skulptur" noindex>
  <div class="mx-auto flex min-h-[60svh] max-w-(--measure-content) flex-col items-center justify-center px-4 text-center sm:px-8">
    {order && order.payment_status === 'paid' ? (
      <>
        <p class="caption">Thank you</p>
        <h1 class="font-display mt-4 text-3xl sm:text-5xl">Order confirmed</h1>
        <p class="mt-4 text-(--color-ink-soft)">
          Order <strong>{order.order_number}</strong> — {order.total.toFixed(2)} {order.currency}
        </p>
        <p class="mt-2 text-sm text-(--color-ink-faint)">A confirmation email is on its way.</p>
      </>
    ) : order ? (
      <>
        <h1 class="font-display mt-4 text-3xl sm:text-4xl">Payment processing</h1>
        <p class="mt-4 text-(--color-ink-soft)">
          We're still confirming your payment — this page will update shortly. If you don't receive a
          confirmation email within a few minutes, please <a href="/contact" class="text-(--color-clay) hover:underline">contact us</a>.
        </p>
      </>
    ) : (
      <>
        <h1 class="font-display mt-4 text-3xl sm:text-4xl">Order not found</h1>
        <p class="mt-4 text-(--color-ink-soft)">We couldn't find this order.</p>
      </>
    )}
    <a href="/shop" class="mt-10 inline-block text-sm tracking-[0.04em] text-(--color-clay) hover:underline">
      Continue shopping &rarr;
    </a>
  </div>
</Layout>
