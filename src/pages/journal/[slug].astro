---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { getSupabaseClient } from '../../lib/supabase';
import { publicMediaUrl, scaledHeight } from '../../lib/media';
import { renderMarkdown } from '../../lib/markdown';

const supabase = getSupabaseClient();
const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

const { data: post } = await supabase
  .from('posts')
  .select(
    `title, excerpt, body, published_at, seo_title, seo_description, hero_focal_x, hero_focal_y,
     cover:cover_media_id (storage_path, bucket, alt_text),
     content_image:content_image_media_id (storage_path, bucket, alt_text, caption, width, height),
     post_images (display_order, media:media_id (storage_path, bucket, alt_text, caption, width, height))`
  )
  .eq('slug', slug)
  .eq('published', true)
  .single();

if (!post) {
  return Astro.redirect('/404');
}

const images = (post.post_images ?? []).sort((a, b) => a.display_order - b.display_order);
const title = post.seo_title ?? `${post.title} — JTP Skulptur`;
const ogImage = post.cover ? publicMediaUrl(post.cover.bucket, post.cover.storage_path) : undefined;
// Body is authored as Markdown in Admin (same convention as newsletter
// campaigns — see lib/email-templates.ts / admin/newsletter) — paragraphs,
// # headings, **bold**, _italic_, and [links](url) all just work, with no
// separate rich-text editor needed. Plain text written before this existed
// still renders the same as before: blank-line-separated lines become their
// own paragraphs either way.
const bodyHtml = renderMarkdown(post.body);
---

<Layout title={title} description={post.seo_description ?? post.excerpt ?? undefined} ogImage={ogImage} ogImageFocal={{ x: post.hero_focal_x, y: post.hero_focal_y }}>
  <article>
    {post.cover && (
      // object-position is applied by the script below, not a style prop
      // here — the site's CSP is style-src 'self' in production (no
      // 'unsafe-inline'), which silently drops inline style="" attributes
      // entirely. Setting el.style.objectPosition from a <script> is a
      // script-src action, not style-src, so it isn't affected — same
      // approach as the homepage hero's focal point (src/pages/index.astro).
      <Image
        id="journal-hero-image"
        src={publicMediaUrl(post.cover.bucket, post.cover.storage_path)}
        alt={post.cover.alt_text ?? post.title}
        width={1600}
        height={1000}
        densities={[1, 2]}
        quality={80}
        fetchpriority="high"
        class="h-[50svh] w-full object-cover sm:h-[65svh]"
        data-focal-x={post.hero_focal_x}
        data-focal-y={post.hero_focal_y}
      />
    )}

    <div class="mx-auto max-w-(--measure-content) px-4 py-12 sm:px-8 sm:py-16">
      {post.published_at && (
        <p class="caption">{new Date(post.published_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
      )}
      <h1 class="font-display mt-3 text-3xl sm:text-4xl">{post.title}</h1>
      {bodyHtml && <div class="journal-body mt-8 leading-relaxed" set:html={bodyHtml} />}
    </div>

    {/* Admin → Journal → Content image (optional) — a second, independent
        image slot from the hero above. Same figure treatment as the
        pre-existing post_images gallery below (object-contain, so the
        whole photo is always visible, never cropped or distorted), and the
        same slot/position Exhibitions just gained (content_image_media_id
        on exhibitions). Renders nothing if not set. */}
    {post.content_image && (
      <div class="mx-auto max-w-(--measure-full) px-4 pb-16 sm:px-8">
        <figure>
          <Image
            src={publicMediaUrl(post.content_image.bucket, post.content_image.storage_path)}
            alt={post.content_image.alt_text ?? post.title}
            width={1400}
            height={scaledHeight(1400, post.content_image)}
            densities={[1, 1.5]}
            quality={80}
            loading="lazy"
            class="mx-auto max-h-[85vh] w-full bg-(--color-paper-raised) object-contain"
          />
          {post.content_image.caption && <figcaption class="caption mt-2">{post.content_image.caption}</figcaption>}
        </figure>
      </div>
    )}

    {images.length > 0 && (
      <div class="mx-auto max-w-(--measure-full) space-y-4 px-4 pb-16 sm:px-8">
        {images.map(({ media }) => media && (
          <figure>
            <Image
              src={publicMediaUrl(media.bucket, media.storage_path)}
              alt={media.alt_text ?? post.title}
              width={1400}
              height={scaledHeight(1400, media)}
              densities={[1, 1.5]}
              quality={80}
              loading="lazy"
              class="mx-auto max-h-[85vh] w-full bg-(--color-paper-raised) object-contain"
            />
            {media.caption && <figcaption class="caption mt-2">{media.caption}</figcaption>}
          </figure>
        ))}
      </div>
    )}

    <div class="mx-auto max-w-(--measure-content) px-4 pb-16 sm:px-8">
      <a href="/journal" class="text-sm tracking-[0.04em] text-(--color-clay) hover:underline">&larr; Back to Journal</a>
    </div>
  </article>
</Layout>

<script>
  // Applies the hero's admin-set focal point (Admin → Journal → Hero Focal
  // Point, hero_focal_x/y on posts) — see the comment by the <Image> above
  // for why this runs via the CSSOM rather than a style="" attribute.
  // Defaults to 50/50 (center) via the data attributes' own fallback, which
  // matches the column's own database default for posts saved before this
  // feature existed.
  const heroImage = document.getElementById('journal-hero-image') as HTMLImageElement | null;
  if (heroImage) {
    const x = heroImage.dataset.focalX ?? '50';
    const y = heroImage.dataset.focalY ?? '50';
    heroImage.style.objectPosition = `${x}% ${y}%`;
  }
</script>

<style>
  /* Tailwind's preflight strips default heading/list/link styling — this is
     raw HTML rendered from the post's Markdown body (set:html), so it needs
     minimal readable styles back that match the site's existing type scale,
     same approach already used for newsletter content (see
     admin/newsletter/[id].astro's .prose-newsletter). Plain paragraphs
     (the only thing any existing post uses) render identically to before. */
  .journal-body :global(p) {
    margin-bottom: 1.5em;
  }
  .journal-body :global(h1),
  .journal-body :global(h2),
  .journal-body :global(h3) {
    font-family: var(--font-serif);
    font-weight: 400;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }
  .journal-body :global(h1) {
    font-size: 1.5em;
  }
  .journal-body :global(h2) {
    font-size: 1.25em;
  }
  .journal-body :global(ul),
  .journal-body :global(ol) {
    margin-bottom: 1.5em;
    padding-left: 1.25em;
  }
  .journal-body :global(ul) {
    list-style: disc;
  }
  .journal-body :global(ol) {
    list-style: decimal;
  }
  .journal-body :global(a) {
    color: var(--color-clay);
    text-decoration: underline;
  }
  .journal-body :global(strong) {
    font-weight: 600;
  }
</style>
