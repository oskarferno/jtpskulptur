---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { getSupabaseClient } from '../lib/supabase';
import { publicMediaUrl } from '../lib/media';

const supabase = getSupabaseClient();

const { data: about } = await supabase
  .from('about_content')
  .select(
    `artist_name, short_bio, full_bio, artist_statement, education, awards, collections, press,
     portrait:portrait_media_id (storage_path, bucket, alt_text),
     cv:cv_media_id (storage_path, bucket)`
  )
  .single();

type ListEntry = { year?: string; label?: string; description?: string };
const education = (about?.education ?? []) as ListEntry[];
const awards = (about?.awards ?? []) as ListEntry[];
const collections = (about?.collections ?? []) as ListEntry[];
const press = (about?.press ?? []) as ListEntry[];
// About Page Bio (full_bio). Falls back to short_bio only if it's empty, so the
// page never shows a blank bio — never to the homepage bio.
const bioParagraphs = (about?.full_bio || about?.short_bio || '').split('\n').filter(Boolean);

const personJsonLd = about?.artist_name
  ? {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: about.artist_name,
      description: about.short_bio ?? undefined,
      image: about.portrait ? publicMediaUrl(about.portrait.bucket, about.portrait.storage_path) : undefined,
      jobTitle: 'Sculptor',
    }
  : undefined;
---

<Layout
  title={`About — ${about?.artist_name ?? 'JTP Skulptur'}`}
  description={about?.short_bio ?? undefined}
  jsonLd={personJsonLd}
>
  {/* Uses the same --measure-content width as the body below (rather than
      the wider --measure-full band Portfolio/Shop/Exhibitions use for their
      listing-page banners), so the title lines up with the bio's left edge
      at every breakpoint — one continuous reading column, like a single
      artist-profile page, instead of a wide banner sitting above a
      narrower, visually disconnected text block. */}
  <header class="mx-auto max-w-(--measure-content) px-4 pt-14 sm:px-8 sm:pt-20">
    <p class="caption">About</p>
    <h1 class="font-display mt-3 text-3xl sm:text-5xl">{about?.artist_name ?? 'JTP Skulptur'}</h1>
  </header>

  <div class="mx-auto max-w-(--measure-content) px-4 py-10 sm:px-8 sm:py-14">
    {about?.portrait && (
      <Image
        src={publicMediaUrl(about.portrait.bucket, about.portrait.storage_path)}
        alt={about.portrait.alt_text ?? about?.artist_name ?? 'Portrait'}
        width={500}
        height={625}
        densities={[1, 1.5, 2]}
        quality={80}
        class="mb-10 aspect-[4/5] w-full max-w-sm object-cover object-top"
      />
    )}

    {bioParagraphs.map((p) => <p class="mt-6 leading-relaxed first:mt-0">{p}</p>)}

    {about?.artist_statement && (
      <blockquote class="font-display mt-12 border-l-2 border-(--color-clay) pl-6 text-xl leading-snug text-(--color-ink-soft) sm:text-2xl">
        {about.artist_statement}
      </blockquote>
    )}

    {education.length > 0 && (
      <section class="mt-16">
        <p class="caption">Education</p>
        <ul class="mt-4 space-y-2">
          {education.map((item) => (
            <li class="flex gap-4 text-sm">
              {item.year && <span class="w-14 flex-shrink-0 text-(--color-ink-faint)">{item.year}</span>}
              <span>{item.label ?? item.description}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {awards.length > 0 && (
      <section class="mt-12">
        <p class="caption">Awards</p>
        <ul class="mt-4 space-y-2">
          {awards.map((item) => (
            <li class="flex gap-4 text-sm">
              {item.year && <span class="w-14 flex-shrink-0 text-(--color-ink-faint)">{item.year}</span>}
              <span>{item.label ?? item.description}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {collections.length > 0 && (
      <section class="mt-12">
        <p class="caption">Collections</p>
        <ul class="mt-4 space-y-2">
          {collections.map((item) => (
            <li class="flex gap-4 text-sm">
              {item.year && <span class="w-14 flex-shrink-0 text-(--color-ink-faint)">{item.year}</span>}
              <span>{item.label ?? item.description}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {press.length > 0 && (
      <section class="mt-12">
        <p class="caption">Press</p>
        <ul class="mt-4 space-y-2">
          {press.map((item) => (
            <li class="flex gap-4 text-sm">
              {item.year && <span class="w-14 flex-shrink-0 text-(--color-ink-faint)">{item.year}</span>}
              <span>{item.label ?? item.description}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {about?.cv && (
      <p class="mt-16">
        <a
          href={publicMediaUrl(about.cv.bucket, about.cv.storage_path)}
          class="text-sm tracking-[0.04em] text-(--color-clay) uppercase hover:underline"
          target="_blank"
          rel="noopener noreferrer"
        >
          Download CV
        </a>
      </p>
    )}
  </div>
</Layout>
