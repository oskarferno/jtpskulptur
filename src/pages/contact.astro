---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { getSupabaseClient } from '../lib/supabase';
import { publicMediaUrl } from '../lib/media';

const supabase = getSupabaseClient();

// Arriving from an artwork page's "Ask about this work" link — see
// portfolio/[slug].astro. The slug is never trusted directly: it's only
// ever used to look up a real, published artwork, and if it doesn't match
// one, this quietly falls back to a normal, contextless Contact page
// rather than showing an error. Sold/not-for-sale artworks resolve here
// too (only `published` matters) since an enquiry isn't a purchase action.
const artworkSlugParam = Astro.url.searchParams.get('artwork');

// None of these four depend on each other's result, so there's no reason
// to make one wait for the previous to finish.
const [{ data: settings }, { data: socialLinks }, { data: sideImage }, { data: enquiryArtwork }] = await Promise.all([
  supabase
    .from('site_settings')
    .select(
      `contact_intro, contact_email, phone, studio_location, contact_form_enabled, contact_image_focal_x, contact_image_focal_y,
       contact_image:contact_image_media_id (storage_path, bucket, alt_text)`
    )
    .single(),
  supabase.from('social_links').select('id, label, url').eq('published', true).order('display_order'),
  supabase
    .from('artworks')
    .select('title, media:primary_image_id (storage_path, bucket, alt_text)')
    .eq('published', true)
    .order('display_order', { ascending: false })
    .order('created_at', { ascending: false })
    .order('id', { ascending: false })
    .limit(1)
    .single(),
  artworkSlugParam
    ? supabase.from('artworks').select('slug, title').eq('slug', artworkSlugParam).eq('published', true).maybeSingle()
    : Promise.resolve({ data: null }),
]);

// The side image is chosen in Admin → Site Settings → Contact Page Image.
// When none is set (or its file was deleted from the media library, which
// clears the reference), this falls back to the page's original behaviour —
// the latest published artwork's image — so it never renders empty or broken.
const contactImage = settings?.contact_image ?? null;
const sideMedia = contactImage ?? sideImage?.media ?? null;
const sideAlt = contactImage
  ? (contactImage.alt_text ?? 'JTP Skulptur')
  : (sideImage?.media?.alt_text ?? sideImage?.title ?? '');
---

<Layout title="Contact — JTP Skulptur" description={settings?.contact_intro ?? undefined}>
  {/* Capped at the same width as every other page's content, so the left edge of
      "Get in touch" lands in the same place as Portfolio/Exhibitions/etc. at very
      wide viewports. Stacked at every breakpoint — image above the form — the same
      order mobile already used; tablet/desktop used to switch to a side-by-side
      sm:grid-cols-2 split instead, which this removes in favour of carrying that
      same vertical order up, with the image given the Journal article hero's own
      desktop/laptop height (sm:h-[65svh], see journal/[slug].astro) and the text
      column capped to the same --measure-content reading width Journal centers
      its text under — both only at sm: and up, so mobile (the unprefixed classes
      below) is untouched. */}
  <div class="mx-auto grid max-w-(--measure-full) grid-cols-1">
    <div class="order-2 flex flex-col justify-center px-4 py-14 sm:mx-auto sm:w-full sm:max-w-(--measure-content) sm:px-8 sm:py-20">
      <p class="caption">Contact</p>
      <h1 class="font-display mt-3 text-3xl sm:text-4xl">Get in touch</h1>

      {settings?.contact_intro && <p class="mt-6 max-w-prose leading-relaxed">{settings.contact_intro}</p>}

      <dl class="mt-10 space-y-3 text-sm">
        {settings?.contact_email && (
          <div class="flex gap-3">
            <dt class="w-20 flex-shrink-0 text-(--color-ink-faint)">Email</dt>
            <dd><a href={`mailto:${settings.contact_email}`} class="hover:text-(--color-clay)">{settings.contact_email}</a></dd>
          </div>
        )}
        {settings?.phone && (
          <div class="flex gap-3">
            <dt class="w-20 flex-shrink-0 text-(--color-ink-faint)">Phone</dt>
            <dd>{settings.phone}</dd>
          </div>
        )}
        {settings?.studio_location && (
          <div class="flex gap-3">
            <dt class="w-20 flex-shrink-0 text-(--color-ink-faint)">Studio</dt>
            <dd>{settings.studio_location}</dd>
          </div>
        )}
        {socialLinks?.map((link) => (
          <div class="flex gap-3">
            <dt class="w-20 flex-shrink-0 text-(--color-ink-faint)">{link.label}</dt>
            <dd><a href={link.url} target="_blank" rel="noopener noreferrer" class="hover:text-(--color-clay)">{link.url}</a></dd>
          </div>
        ))}
      </dl>

      {settings?.contact_form_enabled !== false && (
        <form id="contact-form" method="POST" action="/api/contact" class="mt-12 max-w-md space-y-4">
          <input type="text" name="company" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <input type="hidden" name="rendered_at" value={Date.now()} />
          {enquiryArtwork && <input type="hidden" name="artwork_slug" value={enquiryArtwork.slug} />}

          {enquiryArtwork && (
            <p class="text-sm text-(--color-ink-soft)">
              Enquiring about <span class="text-(--color-ink)">{enquiryArtwork.title}</span>
            </p>
          )}

          <div>
            <label for="name" class="block text-sm text-(--color-ink-soft)">Name</label>
            <input id="name" name="name" type="text" required maxlength="200"
              class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay)" />
          </div>
          <div>
            <label for="email" class="block text-sm text-(--color-ink-soft)">Email</label>
            <input id="email" name="email" type="email" required
              class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay)" />
          </div>
          <div>
            <label for="subject" class="block text-sm text-(--color-ink-soft)">Subject</label>
            <input id="subject" name="subject" type="text" maxlength="300"
              value={enquiryArtwork ? `Enquiry about "${enquiryArtwork.title}"` : undefined}
              class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay)" />
          </div>
          <div>
            <label for="message" class="block text-sm text-(--color-ink-soft)">Message</label>
            <textarea id="message" name="message" required rows="5" maxlength="5000"
              class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay)"></textarea>
          </div>

          <button type="submit"
            class="border border-(--color-ink) px-6 py-2 text-sm tracking-[0.04em] uppercase transition-colors hover:bg-(--color-ink) hover:text-(--color-paper)">
            Submit
          </button>

          <p id="contact-status" role="status" class="text-sm"></p>
        </form>
      )}
    </div>

    {sideMedia && (
      <div class="order-1">
        {/* object-position is applied by the script below, not a style prop
            here — the site's CSP is style-src 'self' in production (no
            'unsafe-inline'), which silently drops inline style="" attributes
            entirely. Setting el.style.objectPosition from a <script> is a
            script-src action, not style-src, so it isn't affected — same
            approach as the Journal/Exhibition heroes and the homepage hero. */}
        <Image
          id="contact-side-image"
          src={publicMediaUrl(sideMedia.bucket, sideMedia.storage_path)}
          alt={sideAlt}
          width={900}
          height={1200}
          densities={[1, 1.5]}
          quality={80}
          class="h-[45svh] w-full object-cover sm:h-[65svh]"
          data-focal-x={settings?.contact_image_focal_x}
          data-focal-y={settings?.contact_image_focal_y}
        />
      </div>
    )}
  </div>

  <script>
    // Applies the side image's admin-set focal point (Admin → Site Settings
    // → Contact Page Image → Image Focal Point, contact_image_focal_x/y on
    // site_settings) — see the comment by the <Image> above for why this
    // runs via the CSSOM rather than a style="" attribute. Defaults to
    // 50/0 (center, top) via the data attributes' own fallback, which
    // matches the column's own database default — i.e. the exact crop this
    // image always used before this feature existed.
    const sideImage = document.getElementById('contact-side-image') as HTMLImageElement | null;
    if (sideImage) {
      const x = sideImage.dataset.focalX ?? '50';
      const y = sideImage.dataset.focalY ?? '0';
      sideImage.style.objectPosition = `${x}% ${y}%`;
    }
  </script>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('contact-status');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!status) return;

      status.textContent = 'Sending…';
      const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (submitButton) submitButton.disabled = true;

      try {
        const response = await fetch('/api/contact', { method: 'POST', body: new FormData(form) });
        const result = (await response.json().catch(() => ({}))) as { ok?: boolean; error?: string };

        if (response.ok && result.ok) {
          status.textContent = 'Thanks — your message has been sent.';
          form.reset();
        } else {
          status.textContent = result.error ?? 'Something went wrong. Please try again.';
        }
      } catch {
        status.textContent = 'Something went wrong. Please try again.';
      } finally {
        if (submitButton) submitButton.disabled = false;
      }
    });
  </script>
</Layout>
