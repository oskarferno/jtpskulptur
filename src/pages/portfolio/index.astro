---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { getSupabaseClient } from '../../lib/supabase';
import { publicMediaUrl, scaledHeight } from '../../lib/media';
import { isPurchasable } from '../../lib/availability';

const supabase = getSupabaseClient();

const [{ data: settings }, { data: artworks }] = await Promise.all([
  supabase.from('site_settings').select('seo_default_title, seo_default_description').single(),
  supabase
    .from('artworks')
    .select(
      `id, slug, title, year, availability, inventory, media:primary_image_id (storage_path, bucket, alt_text, width, height)`
    )
    .eq('published', true)
    // Admin-defined order; created_at/id only break ties so it's never left to the database.
    .order('display_order')
    .order('created_at')
    .order('id'),
]);

// A repeating 5-step rhythm of column spans, breaking up the grid so it
// reads as a curated sequence rather than a uniform product grid.
const spanCycle = ['sm:col-span-7', 'sm:col-span-5', 'sm:col-span-4', 'sm:col-span-4', 'sm:col-span-4'];

const title = `Portfolio — ${settings?.seo_default_title ?? 'JTP Skulptur'}`;
---

<Layout title={title} description={settings?.seo_default_description ?? undefined}>
  <header class="mx-auto max-w-(--measure-full) px-4 pt-14 sm:px-8 sm:pt-20">
    <h1 class="font-display text-3xl sm:text-5xl">Portfolio</h1>
  </header>

  {
    artworks && artworks.length > 0 ? (
      <div class="mx-auto grid max-w-(--measure-full) grid-cols-1 gap-4 px-4 pt-10 pb-24 sm:grid-cols-12 sm:gap-6 sm:px-8 sm:pt-14 sm:pb-32">
        {artworks.map((artwork, i) => {
          // The single shared rule (also used by Shop/Cart/Checkout) for
          // whether this card can actually be bought right now — not just
          // artwork.availability alone, which stays 'available' for the
          // ~30 minutes a unique piece is reserved mid-checkout even though
          // it isn't purchasable during that window. See lib/availability.ts.
          const purchasable = isPurchasable({ published: true, availability: artwork.availability, inventory: artwork.inventory });
          const status = artwork.availability;
          return artwork.media && (
          <a
            href={`/portfolio/${artwork.slug}`}
            class:list={['group reveal block', spanCycle[i % spanCycle.length]]}
          >
            <div class="relative">
              <Image
                src={publicMediaUrl(artwork.media.bucket, artwork.media.storage_path)}
                alt={artwork.media.alt_text ?? artwork.title}
                width={800}
                height={scaledHeight(800, artwork.media)}
                densities={[1, 1.5, 2]}
                quality={80}
                loading={i < 2 ? 'eager' : 'lazy'}
                class="aspect-[4/5] w-full bg-(--color-paper-raised) object-cover object-top transition-transform duration-700 group-hover:scale-[1.015]"
              />
              {purchasable && (
                <span class="absolute right-2 bottom-2 bg-(--color-paper)/90 px-2 py-1 text-xs uppercase tracking-[0.04em] text-(--color-clay)">
                  Available
                </span>
              )}
              {status === 'sold' && (
                <span class="absolute right-2 bottom-2 bg-(--color-paper)/90 px-2 py-1 text-xs uppercase tracking-[0.04em] text-(--color-ink-faint)">
                  Sold
                </span>
              )}
            </div>
            <p class="mt-3 flex items-baseline justify-between text-sm">
              <span>{artwork.title}</span>
              {artwork.year && <span class="text-(--color-ink-faint)">{artwork.year}</span>}
            </p>
          </a>
          );
        })}
      </div>
    ) : (
      <p class="mx-auto max-w-(--measure-full) px-4 py-24 text-center text-(--color-ink-soft) sm:px-8">
        Portfolio coming soon.
      </p>
    )
  }

  <script>
    import { initReveal } from '../../lib/reveal';
    initReveal();
  </script>
</Layout>
