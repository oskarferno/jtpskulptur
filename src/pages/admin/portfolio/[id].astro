---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ImagePicker from '../../../components/admin/ImagePicker.astro';
import { publicMediaUrl } from '../../../lib/media';

const supabase = Astro.locals.supabase!;
const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/admin/portfolio');
}

const { data: artwork } = await supabase
  .from('artworks')
  .select(
    `id, slug, title, year, description, material, dimensions, series, category_id, published,
     featured, display_order, seo_title, seo_description, is_homepage_hero, hero_focal_x, hero_focal_y,
     availability, price, currency, inventory, sku, vendor_id,
     primary_media:primary_image_id (storage_path, bucket, alt_text),
     hero_media:hero_image_id (storage_path, bucket, alt_text)`
  )
  .eq('id', id)
  .single();

if (!artwork) {
  return Astro.redirect('/admin/portfolio');
}

const [{ data: categories }, { data: vendors }] = await Promise.all([
  supabase.from('categories').select('id, name').order('display_order'),
  supabase.from('vendors').select('id, name').order('name'),
]);

const primaryImageUrl = artwork.primary_media
  ? publicMediaUrl(artwork.primary_media.bucket, artwork.primary_media.storage_path)
  : null;
const heroImageUrl = artwork.hero_media
  ? publicMediaUrl(artwork.hero_media.bucket, artwork.hero_media.storage_path)
  : null;
---

<AdminLayout title={artwork.title}>
  <div class="mb-6 flex items-center gap-3">
    {artwork.is_homepage_hero ? (
      <span class="border border-(--color-clay) px-3 py-1.5 text-xs uppercase tracking-[0.04em] text-(--color-clay)">
        ★ Homepage Hero
      </span>
    ) : (
      <button type="button" id="set-hero-button"
        class="border border-(--color-line) px-3 py-1.5 text-xs uppercase tracking-[0.04em] text-(--color-ink-soft) hover:border-(--color-clay) hover:text-(--color-clay)">
        Set as homepage hero
      </button>
    )}
    <p id="hero-action-status" class="text-xs text-(--color-ink-soft)"></p>
  </div>

  <form id="artwork-form" class="max-w-xl space-y-4" data-artwork-id={artwork.id}
    data-primary-url={primaryImageUrl ?? ''} data-hero-url={heroImageUrl ?? ''}
    data-focal-x={artwork.hero_focal_x} data-focal-y={artwork.hero_focal_y}>
    <ImagePicker idPrefix="primary" label="Artwork image" helpText="JPG, PNG, or WebP. Max 20MB. Shown in Portfolio and Shop, and on the homepage unless a hero-specific image is set below." />

    <ImagePicker idPrefix="hero" label="Homepage hero image (optional)" helpText="Used on the homepage instead of the artwork image above, if this artwork is the homepage hero. Leave empty to use the artwork image." />

    <p id="homepage-preview-status" class="text-xs text-(--color-ink-soft)"></p>

    <div>
      <label class="block text-sm text-(--color-ink-soft)">Hero Focal Point</label>
      <p class="mt-1 text-xs text-(--color-ink-faint)">
        Click the most important part of the image below. For sculptures, select the head — the homepage keeps
        this point in view no matter how narrow or wide the screen is.
      </p>

      <div id="focal-wrap" class="relative mt-2 inline-block max-w-full select-none" hidden>
        <img id="focal-image" alt="" class="block max-h-96 max-w-full cursor-crosshair" />
        <div
          id="focal-marker"
          class="pointer-events-none absolute h-5 w-5 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-(--color-clay) bg-(--color-paper)/60 shadow-[0_0_0_1px_rgba(0,0,0,0.3)]"
        />
      </div>
      <p id="focal-no-image" class="mt-2 text-xs text-(--color-ink-faint)">
        Add an artwork or hero image above to set a focal point.
      </p>

      <div class="mt-4 max-w-md">
        <p class="text-xs text-(--color-ink-soft)">Homepage preview (approximate)</p>
        <div class="mt-1 aspect-[21/9] w-full overflow-hidden bg-(--color-paper-raised)">
          <img id="focal-hero-preview" alt="" class="h-full w-full object-cover" />
        </div>
      </div>
    </div>

    <div class="flex items-center gap-4 text-sm">
      <label class="flex items-center gap-2">
        <input type="checkbox" name="published" checked={artwork.published} />
        Published
      </label>
      <label class="flex items-center gap-2">
        <input type="checkbox" name="featured" checked={artwork.featured} />
        Featured
      </label>
    </div>

    <div>
      <label for="title" class="block text-sm text-(--color-ink-soft)">Title</label>
      <input id="title" name="title" type="text" required value={artwork.title}
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
    </div>

    <div>
      <label for="slug" class="block text-sm text-(--color-ink-soft)">Slug</label>
      <input id="slug" name="slug" type="text" required value={artwork.slug} pattern="[a-z0-9]+(-[a-z0-9]+)*"
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
      <p class="mt-1 text-xs text-(--color-ink-soft)">Public URL: /portfolio/{artwork.slug}</p>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label for="year" class="block text-sm text-(--color-ink-soft)">Year</label>
        <input id="year" name="year" type="number" value={artwork.year ?? ''}
          class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
      </div>
      <div>
        <label for="category_id" class="block text-sm text-(--color-ink-soft)">Category</label>
        <select id="category_id" name="category_id"
          class="mt-1 w-full border border-(--color-line) bg-(--color-paper) px-3 py-2 focus:border-(--color-clay) focus:outline-none">
          <option value="">—</option>
          {categories?.map((c) => (
            <option value={c.id} selected={c.id === artwork.category_id}>{c.name}</option>
          ))}
        </select>
      </div>
    </div>

    <div>
      <label for="material" class="block text-sm text-(--color-ink-soft)">Material</label>
      <input id="material" name="material" type="text" value={artwork.material ?? ''}
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
    </div>

    <div>
      <label for="dimensions" class="block text-sm text-(--color-ink-soft)">Dimensions</label>
      <input id="dimensions" name="dimensions" type="text" value={artwork.dimensions ?? ''}
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
    </div>

    <div>
      <label for="series" class="block text-sm text-(--color-ink-soft)">Series</label>
      <input id="series" name="series" type="text" value={artwork.series ?? ''}
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
    </div>

    <div>
      <label for="description" class="block text-sm text-(--color-ink-soft)">Description</label>
      <textarea id="description" name="description" rows="5"
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none">{artwork.description ?? ''}</textarea>
    </div>

    <fieldset class="border border-(--color-line) p-4">
      <legend class="px-1 text-sm text-(--color-ink-soft)">Sale</legend>

      <div>
        <label for="availability" class="block text-sm text-(--color-ink-soft)">Availability</label>
        <select id="availability" name="availability"
          class="mt-1 w-full max-w-xs border border-(--color-line) bg-(--color-paper) px-3 py-2 focus:border-(--color-clay) focus:outline-none">
          <option value="not_for_sale" selected={artwork.availability === 'not_for_sale'}>Not for sale</option>
          <option value="available" selected={artwork.availability === 'available'}>Available</option>
          <option value="sold" selected={artwork.availability === 'sold'}>Sold</option>
        </select>
        <p class="mt-1 text-xs text-(--color-ink-soft)">
          Available artworks appear automatically in the Shop — no separate product to create.
        </p>
      </div>

      <div id="commerce-fields" class="mt-4 space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="price" class="block text-sm text-(--color-ink-soft)">Price</label>
            <input id="price" name="price" type="number" step="0.01" min="0" value={artwork.price ?? ''}
              class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
          </div>
          <div>
            <label for="currency" class="block text-sm text-(--color-ink-soft)">Currency</label>
            <input id="currency" name="currency" type="text" value={artwork.currency}
              class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="inventory" class="block text-sm text-(--color-ink-soft)">Inventory</label>
            <input id="inventory" name="inventory" type="number" min="0" step="1" value={artwork.inventory}
              class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
            <p class="mt-1 text-xs text-(--color-ink-soft)">1 for a unique piece.</p>
          </div>
          <div>
            <label for="sku" class="block text-sm text-(--color-ink-soft)">SKU <span class="text-(--color-ink-faint)">(optional)</span></label>
            <input id="sku" name="sku" type="text" value={artwork.sku ?? ''}
              class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
          </div>
        </div>
        <div>
          <label for="vendor_id" class="block text-sm text-(--color-ink-soft)">Vendor <span class="text-(--color-ink-faint)">(optional)</span></label>
          <select id="vendor_id" name="vendor_id"
            class="mt-1 w-full max-w-xs border border-(--color-line) bg-(--color-paper) px-3 py-2 focus:border-(--color-clay) focus:outline-none">
            <option value="">— None (JTP) —</option>
            {vendors?.map((v) => (
              <option value={v.id} selected={v.id === artwork.vendor_id}>{v.name}</option>
            ))}
          </select>
        </div>
      </div>
    </fieldset>

    <fieldset class="border border-(--color-line) p-4">
      <legend class="px-1 text-sm text-(--color-ink-soft)">SEO (optional — falls back to defaults if empty)</legend>
      <div class="mt-2">
        <label for="seo_title" class="block text-sm text-(--color-ink-soft)">SEO title</label>
        <input id="seo_title" name="seo_title" type="text" value={artwork.seo_title ?? ''}
          class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
      </div>
      <div class="mt-3">
        <label for="seo_description" class="block text-sm text-(--color-ink-soft)">SEO description</label>
        <textarea id="seo_description" name="seo_description" rows="2"
          class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none">{artwork.seo_description ?? ''}</textarea>
      </div>
    </fieldset>

    <div class="flex items-center gap-4">
      <button type="submit"
        class="border border-(--color-ink) px-6 py-2 text-sm tracking-wide uppercase transition-colors hover:bg-(--color-ink) hover:text-(--color-paper)">
        Save
      </button>
      <button type="button" id="delete-button"
        class="text-sm text-red-700 hover:underline">
        Delete
      </button>
      <p id="form-status" role="status" class="text-sm"></p>
    </div>
  </form>

  <script>
    import { initImagePicker, initFocalPicker, uploadImage } from '../../../lib/admin-image-picker';

    const form = document.getElementById('artwork-form') as HTMLFormElement;
    const status = document.getElementById('form-status')!;
    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const deleteButton = document.getElementById('delete-button');
    const artworkId = form.dataset.artworkId!;
    const availabilitySelect = document.getElementById('availability') as unknown as HTMLSelectElement;
    const commerceFields = document.getElementById('commerce-fields')!;
    const priceInput = document.getElementById('price') as HTMLInputElement;

    const homepagePreviewStatus = document.getElementById('homepage-preview-status')!;

    const focalPicker = initFocalPicker(
      {
        wrap: document.getElementById('focal-wrap')!,
        image: document.getElementById('focal-image') as HTMLImageElement,
        marker: document.getElementById('focal-marker')!,
        noImageMessage: document.getElementById('focal-no-image')!,
        heroPreview: document.getElementById('focal-hero-preview') as HTMLImageElement,
      },
      { x: Number(form.dataset.focalX) || 50, y: Number(form.dataset.focalY) || 0 }
    );

    // Whichever image would actually render as the homepage hero right now
    // (hero-specific if set, else the artwork image, else none) — read
    // straight from the pickers' own preview <img>s rather than re-deriving
    // object URLs, since initImagePicker already keeps those in sync with
    // its current state.
    function getEffectivePreviewSrc(): string | null {
      if (heroPicker.hasImage()) return (document.getElementById('hero-preview') as HTMLImageElement).src;
      if (primaryPicker.hasImage()) return (document.getElementById('primary-preview') as HTMLImageElement).src;
      return null;
    }

    function updateHomepagePreview() {
      if (heroPicker.hasImage()) {
        homepagePreviewStatus.textContent = 'If this artwork is the homepage hero, the homepage will use the hero image above.';
      } else if (primaryPicker.hasImage()) {
        homepagePreviewStatus.textContent = 'If this artwork is the homepage hero, the homepage will use the artwork image above (no hero-specific image set).';
      } else {
        homepagePreviewStatus.textContent = 'This artwork has no image yet, so it can’t be used as the homepage hero until one is added.';
      }
      focalPicker.setImageSrc(getEffectivePreviewSrc());
    }

    const primaryPicker = initImagePicker(
      {
        fileInput: document.getElementById('primary-file') as HTMLInputElement,
        preview: document.getElementById('primary-preview') as HTMLImageElement,
        placeholder: document.getElementById('primary-placeholder')!,
        removeButton: document.getElementById('primary-remove') as HTMLButtonElement,
        status: document.getElementById('primary-status')!,
      },
      form.dataset.primaryUrl || null,
      updateHomepagePreview
    );

    const heroPicker = initImagePicker(
      {
        fileInput: document.getElementById('hero-file') as HTMLInputElement,
        preview: document.getElementById('hero-preview') as HTMLImageElement,
        placeholder: document.getElementById('hero-placeholder')!,
        removeButton: document.getElementById('hero-remove') as HTMLButtonElement,
        status: document.getElementById('hero-status') as unknown as HTMLElement,
      },
      form.dataset.heroUrl || null,
      updateHomepagePreview
    );

    updateHomepagePreview();

    const setHeroButton = document.getElementById('set-hero-button');
    const heroActionStatus = document.getElementById('hero-action-status')!;

    setHeroButton?.addEventListener('click', async () => {
      setHeroButton.setAttribute('disabled', 'true');
      heroActionStatus.textContent = 'Setting as homepage hero…';
      const response = await fetch(`/api/admin/artworks/${artworkId}/hero`, { method: 'POST' });
      if (response.ok) {
        window.location.reload();
      } else {
        const result = (await response.json().catch(() => ({}))) as { error?: string };
        heroActionStatus.textContent = result.error ?? 'Could not set as homepage hero.';
        setHeroButton.removeAttribute('disabled');
      }
    });

    // Commerce fields stay visible regardless of availability (so price/
    // inventory already entered aren't hidden and lost from view), but only
    // matter — and are only required — once Available is selected.
    function syncCommerceEmphasis() {
      const isAvailable = availabilitySelect.value === 'available';
      commerceFields.classList.toggle('opacity-100', isAvailable);
      commerceFields.classList.toggle('opacity-60', !isAvailable);
      priceInput.required = isAvailable;
    }
    availabilitySelect.addEventListener('change', syncCommerceEmphasis);
    syncCommerceEmphasis();

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(form);

      if (formData.get('availability') === 'available' && !formData.get('price')) {
        status.textContent = 'A price is required before this artwork can be marked Available.';
        return;
      }

      const payload: Record<string, unknown> = {
        title: formData.get('title'),
        slug: formData.get('slug'),
        year: formData.get('year') ? Number(formData.get('year')) : null,
        description: formData.get('description') || null,
        material: formData.get('material') || null,
        dimensions: formData.get('dimensions') || null,
        series: formData.get('series') || null,
        category_id: formData.get('category_id') || null,
        published: formData.get('published') === 'on',
        featured: formData.get('featured') === 'on',
        seo_title: formData.get('seo_title') || null,
        seo_description: formData.get('seo_description') || null,
        availability: formData.get('availability'),
        price: formData.get('price') ? Number(formData.get('price')) : null,
        currency: formData.get('currency') || 'SEK',
        inventory: formData.get('inventory') ? Number(formData.get('inventory')) : 1,
        sku: formData.get('sku') || null,
        vendor_id: formData.get('vendor_id') || null,
      };

      const focalPosition = focalPicker.getPosition();
      payload.hero_focal_x = focalPosition.x;
      payload.hero_focal_y = focalPosition.y;

      submitButton.disabled = true;

      const title = formData.get('title') as string;
      const primaryState = primaryPicker.getState();
      const heroState = heroPicker.getState();

      try {
        if (primaryState.kind === 'file') {
          status.textContent = 'Uploading artwork image…';
          payload.primary_image_id = await uploadImage(primaryState.file, 'artwork-images', title);
        } else if (primaryState.kind === 'removed') {
          payload.primary_image_id = null;
        }

        if (heroState.kind === 'file') {
          status.textContent = 'Uploading hero image…';
          payload.hero_image_id = await uploadImage(heroState.file, 'artwork-images', `${title} (homepage hero)`);
        } else if (heroState.kind === 'removed') {
          payload.hero_image_id = null;
        }
      } catch (err) {
        status.textContent = err instanceof Error ? err.message : 'Image upload failed.';
        submitButton.disabled = false;
        return;
      }

      status.textContent = 'Saving…';
      const response = await fetch(`/api/admin/artworks/${artworkId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = (await response.json().catch(() => ({}))) as { error?: string };

      status.textContent = response.ok ? 'Saved.' : (result.error ?? 'Something went wrong.');
      submitButton.disabled = false;
      if (response.ok) {
        window.location.reload();
      }
    });

    deleteButton?.addEventListener('click', async () => {
      if (!confirm('Delete this artwork permanently? This cannot be undone.')) return;
      const response = await fetch(`/api/admin/artworks/${artworkId}`, { method: 'DELETE' });
      if (response.ok) {
        window.location.href = '/admin/portfolio';
      } else {
        status.textContent = 'Could not delete.';
      }
    });
  </script>
</AdminLayout>
