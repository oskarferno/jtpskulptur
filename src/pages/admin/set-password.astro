---
import '../../styles/global.css';

export const prerender = false;

// Reached only after /api/admin/confirm has already established a session
// (verifyOtp + redirect here) — the normal admin gate in middleware.ts
// applies to this page like any other /admin route, since the profiles row
// for an invited user is created with role='admin' before the invite is
// ever sent.
const error = Astro.url.searchParams.get('error');
const errorMessage =
  error === 'mismatch'
    ? 'Passwords do not match.'
    : error === 'weak'
      ? 'Password must be at least 8 characters.'
      : error === 'expired'
        ? 'This link is invalid or has already been used. Please request a new invite or password reset.'
        : error === 'updatefailed'
          ? 'Could not set password. Please request a new link and try again.'
          : null;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Set password — jtp.skulptur admin</title>
  </head>
  <body class="flex min-h-screen items-center justify-center bg-(--color-paper) text-(--color-ink)">
    <form method="POST" action="/api/admin/set-password" class="w-full max-w-sm space-y-4 px-6">
      <h1 class="font-display text-2xl">Set your password</h1>

      {errorMessage && <p class="text-sm text-red-700">{errorMessage}</p>}

      <div>
        <label for="password" class="block text-sm text-(--color-ink-soft)">New password</label>
        <input id="password" name="password" type="password" required minlength="8" autocomplete="new-password"
          class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
      </div>
      <div>
        <label for="confirm" class="block text-sm text-(--color-ink-soft)">Confirm password</label>
        <input id="confirm" name="confirm" type="password" required minlength="8" autocomplete="new-password"
          class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
      </div>

      <button type="submit"
        class="w-full border border-(--color-ink) px-6 py-2 text-sm tracking-wide uppercase transition-colors hover:bg-(--color-ink) hover:text-(--color-paper)">
        Set password
      </button>
    </form>
  </body>
</html>
