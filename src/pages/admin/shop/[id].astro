---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { publicMediaUrl } from '../../../lib/media';

const supabase = Astro.locals.supabase!;
const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/admin/shop');
}

const { data: product } = await supabase
  .from('products')
  .select(
    `id, slug, name, description, short_description, category, price, currency, sku, inventory, active, featured,
     vendor_id, seo_title, seo_description,
     primary_media:primary_image_id (storage_path, bucket, alt_text)`
  )
  .eq('id', id)
  .single();

if (!product) {
  return Astro.redirect('/admin/shop');
}

const { data: vendors } = await supabase.from('vendors').select('id, name').order('name');
---

<AdminLayout title={product.name}>
  <p class="max-w-xl text-sm text-(--color-ink-soft)">
    For non-artwork items only — sculptures are managed from <a href="/admin/portfolio" class="text-(--color-clay) hover:underline">Portfolio</a>, where setting an artwork's availability to Available is what puts it in the Shop.
  </p>
  <form id="product-form" class="mt-6 max-w-xl space-y-4" data-product-id={product.id}>
    <div>
      <p class="text-sm text-(--color-ink-soft)">Primary image</p>
      {product.primary_media && (
        <img
          src={publicMediaUrl(product.primary_media.bucket, product.primary_media.storage_path)}
          alt=""
          class="mt-2 aspect-square w-40 border border-(--color-line) object-cover"
        />
      )}
      <input type="file" id="image-upload" accept="image/jpeg,image/png,image/webp" class="mt-2 block text-sm" />
      <p id="upload-status" class="mt-1 text-xs text-(--color-ink-soft)"></p>
    </div>

    <div class="flex items-center gap-4 text-sm">
      <label class="flex items-center gap-2">
        <input type="checkbox" name="active" checked={product.active} />
        Active (visible in shop)
      </label>
      <label class="flex items-center gap-2">
        <input type="checkbox" name="featured" checked={product.featured} />
        Featured
      </label>
    </div>

    <div>
      <label for="name" class="block text-sm text-(--color-ink-soft)">Name</label>
      <input id="name" name="name" type="text" required value={product.name}
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
    </div>

    <div>
      <label for="slug" class="block text-sm text-(--color-ink-soft)">Slug</label>
      <input id="slug" name="slug" type="text" required value={product.slug} pattern="[a-z0-9]+(-[a-z0-9]+)*"
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
      <p class="mt-1 text-xs text-(--color-ink-soft)">Public URL: /shop/{product.slug}</p>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label for="price" class="block text-sm text-(--color-ink-soft)">Price</label>
        <input id="price" name="price" type="number" step="0.01" min="0" required value={product.price}
          class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
      </div>
      <div>
        <label for="inventory" class="block text-sm text-(--color-ink-soft)">Inventory</label>
        <input id="inventory" name="inventory" type="number" min="0" step="1" required value={product.inventory}
          class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label for="category" class="block text-sm text-(--color-ink-soft)">Category</label>
        <select id="category" name="category"
          class="mt-1 w-full border border-(--color-line) bg-(--color-paper) px-3 py-2 focus:border-(--color-clay) focus:outline-none">
          {['sculpture', 'print', 'book', 'merchandise', 'limited_edition', 'other'].map((c) => (
            <option value={c} selected={c === product.category}>{c}</option>
          ))}
        </select>
      </div>
      <div>
        <label for="sku" class="block text-sm text-(--color-ink-soft)">SKU</label>
        <input id="sku" name="sku" type="text" value={product.sku ?? ''}
          class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
      </div>
    </div>

    <div>
      <label for="vendor_id" class="block text-sm text-(--color-ink-soft)">Vendor</label>
      <select id="vendor_id" name="vendor_id"
        class="mt-1 w-full max-w-xs border border-(--color-line) bg-(--color-paper) px-3 py-2 focus:border-(--color-clay) focus:outline-none">
        <option value="">— None (JTP) —</option>
        {vendors?.map((v) => (
          <option value={v.id} selected={v.id === product.vendor_id}>{v.name}</option>
        ))}
      </select>
    </div>

    <div>
      <label for="short_description" class="block text-sm text-(--color-ink-soft)">Short description</label>
      <input id="short_description" name="short_description" type="text" value={product.short_description ?? ''}
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
    </div>

    <div>
      <label for="description" class="block text-sm text-(--color-ink-soft)">Description</label>
      <textarea id="description" name="description" rows="5"
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none">{product.description ?? ''}</textarea>
    </div>

    <fieldset class="border border-(--color-line) p-4">
      <legend class="px-1 text-sm text-(--color-ink-soft)">SEO (optional — falls back to defaults if empty)</legend>
      <div class="mt-2">
        <label for="seo_title" class="block text-sm text-(--color-ink-soft)">SEO title</label>
        <input id="seo_title" name="seo_title" type="text" value={product.seo_title ?? ''}
          class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
      </div>
      <div class="mt-3">
        <label for="seo_description" class="block text-sm text-(--color-ink-soft)">SEO description</label>
        <textarea id="seo_description" name="seo_description" rows="2"
          class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none">{product.seo_description ?? ''}</textarea>
      </div>
    </fieldset>

    <div class="flex items-center gap-4">
      <button type="submit"
        class="border border-(--color-ink) px-6 py-2 text-sm tracking-wide uppercase transition-colors hover:bg-(--color-ink) hover:text-(--color-paper)">
        Save
      </button>
      <button type="button" id="delete-button" class="text-sm text-red-700 hover:underline">Delete</button>
      <p id="form-status" role="status" class="text-sm"></p>
    </div>
  </form>

  <script>
    const form = document.getElementById('product-form') as HTMLFormElement;
    const status = document.getElementById('form-status')!;
    const deleteButton = document.getElementById('delete-button');
    const productId = form.dataset.productId;
    const imageUpload = document.getElementById('image-upload') as HTMLInputElement;
    const uploadStatus = document.getElementById('upload-status')!;

    imageUpload.addEventListener('change', async () => {
      const file = imageUpload.files?.[0];
      if (!file) return;
      uploadStatus.textContent = 'Uploading…';
      const formData = new FormData();
      formData.append('file', file);
      formData.append('bucket', 'product-images');
      const uploadRes = await fetch('/api/admin/media', { method: 'POST', body: formData });
      const uploadResult = (await uploadRes.json().catch(() => ({}))) as { media?: { id: string }; error?: string };
      if (!uploadRes.ok || !uploadResult.media) {
        uploadStatus.textContent = uploadResult.error ?? 'Upload failed.';
        return;
      }
      const patchRes = await fetch(`/api/admin/products/${productId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ primary_image_id: uploadResult.media.id }),
      });
      uploadStatus.textContent = patchRes.ok ? 'Uploaded — reloading…' : 'Uploaded, but could not set as primary image.';
      if (patchRes.ok) window.location.reload();
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(form);

      const payload = {
        name: formData.get('name'),
        slug: formData.get('slug'),
        price: Number(formData.get('price')),
        inventory: Number(formData.get('inventory')),
        category: formData.get('category'),
        sku: formData.get('sku') || null,
        vendor_id: formData.get('vendor_id') || null,
        short_description: formData.get('short_description') || null,
        description: formData.get('description') || null,
        active: formData.get('active') === 'on',
        featured: formData.get('featured') === 'on',
        seo_title: formData.get('seo_title') || null,
        seo_description: formData.get('seo_description') || null,
      };

      status.textContent = 'Saving…';
      const response = await fetch(`/api/admin/products/${productId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = (await response.json().catch(() => ({}))) as { error?: string };
      status.textContent = response.ok ? 'Saved.' : (result.error ?? 'Something went wrong.');
    });

    deleteButton?.addEventListener('click', async () => {
      if (!confirm('Delete this product permanently? This cannot be undone. (Existing orders keep their own snapshot of this product\'s details.)')) return;
      const response = await fetch(`/api/admin/products/${productId}`, { method: 'DELETE' });
      if (response.ok) {
        window.location.href = '/admin/shop';
      } else {
        status.textContent = 'Could not delete.';
      }
    });
  </script>
</AdminLayout>
