---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="New product">
  <form id="new-product-form" class="max-w-md space-y-4">
    <div>
      <label for="name" class="block text-sm text-(--color-ink-soft)">Name</label>
      <input id="name" name="name" type="text" required
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
    </div>
    <div>
      <label for="slug" class="block text-sm text-(--color-ink-soft)">Slug</label>
      <input id="slug" name="slug" type="text" required pattern="[a-z0-9]+(-[a-z0-9]+)*"
        placeholder="lowercase-with-hyphens"
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
    </div>
    <div>
      <label for="price" class="block text-sm text-(--color-ink-soft)">Price</label>
      <input id="price" name="price" type="number" step="0.01" min="0" required
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
    </div>
    <button type="submit"
      class="border border-(--color-ink) px-6 py-2 text-sm tracking-wide uppercase hover:bg-(--color-ink) hover:text-(--color-paper)">
      Create
    </button>
    <p id="form-status" role="status" class="text-sm"></p>
  </form>

  <script>
    const form = document.getElementById('new-product-form') as HTMLFormElement;
    const status = document.getElementById('form-status')!;
    const nameInput = document.getElementById('name') as HTMLInputElement;
    const slugInput = document.getElementById('slug') as HTMLInputElement;
    let slugEdited = false;

    slugInput.addEventListener('input', () => { slugEdited = true; });
    nameInput.addEventListener('input', () => {
      if (slugEdited) return;
      slugInput.value = nameInput.value
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(form);
      status.textContent = 'Creating…';

      const response = await fetch('/api/admin/products', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: formData.get('name'),
          slug: formData.get('slug'),
          price: Number(formData.get('price')),
        }),
      });
      const result = (await response.json().catch(() => ({}))) as { product?: { id: string }; error?: string };

      if (response.ok && result.product) {
        window.location.href = `/admin/shop/${result.product.id}`;
      } else {
        status.textContent = result.error ?? 'Something went wrong.';
      }
    });
  </script>
</AdminLayout>
