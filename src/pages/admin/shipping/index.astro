---
import AdminLayout from '../../../layouts/AdminLayout.astro';

const supabase = Astro.locals.supabase!;

const { data: rates } = await supabase
  .from('shipping_rates')
  .select('id, region, label, price, currency, active')
  .order('region');
---

<AdminLayout title="Shipping">
  <p class="text-sm text-(--color-ink-soft)">
    Only active regions are offered at checkout, and the backend rejects any checkout for a region that isn't active
    here — not just hidden on the frontend.
  </p>

  <ul class="mt-6 divide-y divide-(--color-line) border border-(--color-line)">
    {rates?.map((r) => (
      <li class="flex flex-wrap items-center gap-4 px-4 py-3" data-rate-id={r.id}>
        <span class="w-32 flex-shrink-0 text-sm">{r.label}</span>
        <label class="flex items-center gap-2 text-sm">
          <input type="checkbox" class="active-input" checked={r.active} />
          Active
        </label>
        <input type="number" step="0.01" min="0" class="price-input w-28 border border-(--color-line) bg-transparent px-2 py-1 text-sm" value={r.price} />
        <span class="text-sm text-(--color-ink-soft)">{r.currency}</span>
        <button type="button" class="save-button text-sm text-(--color-clay) hover:underline">Save</button>
        <span class="rate-status text-sm text-(--color-ink-soft)"></span>
      </li>
    ))}
  </ul>

  <script>
    document.querySelectorAll<HTMLLIElement>('[data-rate-id]').forEach((row) => {
      const id = row.dataset.rateId!;
      const activeInput = row.querySelector<HTMLInputElement>('.active-input')!;
      const priceInput = row.querySelector<HTMLInputElement>('.price-input')!;
      const saveButton = row.querySelector<HTMLButtonElement>('.save-button')!;
      const statusEl = row.querySelector<HTMLSpanElement>('.rate-status')!;

      saveButton.addEventListener('click', async () => {
        statusEl.textContent = 'Saving…';
        const response = await fetch(`/api/admin/shipping/${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ active: activeInput.checked, price: Number(priceInput.value) }),
        });
        statusEl.textContent = response.ok ? 'Saved.' : 'Failed.';
      });
    });
  </script>
</AdminLayout>
