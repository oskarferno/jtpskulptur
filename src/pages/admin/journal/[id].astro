---
import AdminLayout from '../../../layouts/AdminLayout.astro';

const supabase = Astro.locals.supabase!;
const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/admin/journal');
}

const { data: post } = await supabase
  .from('posts')
  .select('id, title, slug, excerpt, body, published, seo_title, seo_description')
  .eq('id', id)
  .single();

if (!post) {
  return Astro.redirect('/admin/journal');
}
---

<AdminLayout title={post.title}>
  <form id="post-form" class="max-w-xl space-y-4" data-post-id={post.id}>
    <label class="flex items-center gap-2 text-sm">
      <input type="checkbox" name="published" checked={post.published} />
      Published
    </label>

    <div>
      <label for="title" class="block text-sm text-(--color-ink-soft)">Title</label>
      <input id="title" name="title" type="text" required value={post.title}
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
    </div>

    <div>
      <label for="slug" class="block text-sm text-(--color-ink-soft)">Slug</label>
      <input id="slug" name="slug" type="text" required value={post.slug} pattern="[a-z0-9]+(-[a-z0-9]+)*"
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
      <p class="mt-1 text-xs text-(--color-ink-soft)">Public URL: /journal/{post.slug}</p>
    </div>

    <div>
      <label for="excerpt" class="block text-sm text-(--color-ink-soft)">Excerpt</label>
      <textarea id="excerpt" name="excerpt" rows="2"
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none">{post.excerpt ?? ''}</textarea>
    </div>

    <div>
      <label for="body" class="block text-sm text-(--color-ink-soft)">Body</label>
      <textarea id="body" name="body" rows="12"
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none">{post.body ?? ''}</textarea>
    </div>

    <fieldset class="border border-(--color-line) p-4">
      <legend class="px-1 text-sm text-(--color-ink-soft)">SEO (optional)</legend>
      <div class="mt-2">
        <label for="seo_title" class="block text-sm text-(--color-ink-soft)">SEO title</label>
        <input id="seo_title" name="seo_title" type="text" value={post.seo_title ?? ''}
          class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
      </div>
      <div class="mt-3">
        <label for="seo_description" class="block text-sm text-(--color-ink-soft)">SEO description</label>
        <textarea id="seo_description" name="seo_description" rows="2"
          class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none">{post.seo_description ?? ''}</textarea>
      </div>
    </fieldset>

    <div class="flex items-center gap-4">
      <button type="submit"
        class="border border-(--color-ink) px-6 py-2 text-sm tracking-wide uppercase hover:bg-(--color-ink) hover:text-(--color-paper)">
        Save
      </button>
      <button type="button" id="delete-button" class="text-sm text-red-700 hover:underline">Delete</button>
      <p id="form-status" role="status" class="text-sm"></p>
    </div>
  </form>

  <script>
    const form = document.getElementById('post-form') as HTMLFormElement;
    const status = document.getElementById('form-status')!;
    const deleteButton = document.getElementById('delete-button');
    const postId = form.dataset.postId;

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(form);

      const payload = {
        title: formData.get('title'),
        slug: formData.get('slug'),
        excerpt: formData.get('excerpt') || null,
        body: formData.get('body') || null,
        seo_title: formData.get('seo_title') || null,
        seo_description: formData.get('seo_description') || null,
        published: formData.get('published') === 'on',
      };

      status.textContent = 'Saving…';
      const response = await fetch(`/api/admin/posts/${postId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = (await response.json().catch(() => ({}))) as { error?: string };
      status.textContent = response.ok ? 'Saved.' : (result.error ?? 'Something went wrong.');
    });

    deleteButton?.addEventListener('click', async () => {
      if (!confirm('Delete this post permanently?')) return;
      const response = await fetch(`/api/admin/posts/${postId}`, { method: 'DELETE' });
      if (response.ok) {
        window.location.href = '/admin/journal';
      } else {
        status.textContent = 'Could not delete.';
      }
    });
  </script>
</AdminLayout>
