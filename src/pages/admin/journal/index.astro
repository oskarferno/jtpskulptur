---
import AdminLayout from '../../../layouts/AdminLayout.astro';

const supabase = Astro.locals.supabase!;
const { data: posts } = await supabase
  .from('posts')
  .select('id, title, slug, published, published_at')
  .order('created_at', { ascending: false });
---

<AdminLayout title="News / Journal">
  {
    posts && posts.length > 0 ? (
      <ul class="divide-y divide-(--color-line) border border-(--color-line)">
        {posts.map((p) => (
          <li class="flex items-center justify-between px-4 py-3">
            <span>{p.title}</span>
            <span class="text-sm text-(--color-ink-soft)">{p.published ? 'published' : 'draft'}</span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-(--color-ink-soft)">No posts yet.</p>
    )
  }
</AdminLayout>
