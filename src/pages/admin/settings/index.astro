---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ImagePicker from '../../../components/admin/ImagePicker.astro';
import { publicMediaUrl } from '../../../lib/media';

const supabase = Astro.locals.supabase!;
const [{ data: settings }, { data: fallbackArtwork }] = await Promise.all([
  supabase
    .from('site_settings')
    .select('*, contact_image:contact_image_media_id (id, storage_path, bucket, alt_text)')
    .single(),
  // What the Contact page shows when no custom image is set — same query as
  // src/pages/contact.astro, so the admin sees exactly what visitors see.
  supabase
    .from('artworks')
    .select('title, media:primary_image_id (storage_path, bucket)')
    .eq('published', true)
    .order('display_order', { ascending: false })
    .order('created_at', { ascending: false })
    .order('id', { ascending: false })
    .limit(1)
    .single(),
]);

const contactImage = settings?.contact_image ?? null;
const contactImageUrl = contactImage ? publicMediaUrl(contactImage.bucket, contactImage.storage_path) : null;
const fallbackUrl = fallbackArtwork?.media ? publicMediaUrl(fallbackArtwork.media.bucket, fallbackArtwork.media.storage_path) : null;
---

<AdminLayout title="Site Settings">
  <form
    id="settings-form"
    class="max-w-xl space-y-4"
    data-contact-image-url={contactImageUrl ?? ''}
    data-contact-image-id={contactImage?.id ?? ''}
    data-contact-image-alt={contactImage?.alt_text ?? ''}
    data-contact-image-focal-x={settings?.contact_image_focal_x}
    data-contact-image-focal-y={settings?.contact_image_focal_y}
  >
    <div>
      <label for="site_title" class="block text-sm text-(--color-ink-soft)">Site title</label>
      <input id="site_title" name="site_title" type="text" required value={settings?.site_title}
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
    </div>
    <div>
      <label for="tagline" class="block text-sm text-(--color-ink-soft)">Tagline</label>
      <input id="tagline" name="tagline" type="text" value={settings?.tagline ?? ''}
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label for="contact_email" class="block text-sm text-(--color-ink-soft)">Contact email</label>
        <input id="contact_email" name="contact_email" type="email" value={settings?.contact_email ?? ''}
          class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
      </div>
      <div>
        <label for="phone" class="block text-sm text-(--color-ink-soft)">Phone</label>
        <input id="phone" name="phone" type="text" value={settings?.phone ?? ''}
          class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
      </div>
    </div>

    <div>
      <label for="studio_location" class="block text-sm text-(--color-ink-soft)">Studio location</label>
      <input id="studio_location" name="studio_location" type="text" value={settings?.studio_location ?? ''}
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
    </div>

    <div>
      <label for="contact_intro" class="block text-sm text-(--color-ink-soft)">Contact page introduction</label>
      <textarea id="contact_intro" name="contact_intro" rows="3"
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none">{settings?.contact_intro ?? ''}</textarea>
    </div>

    <label class="flex items-center gap-2 text-sm">
      <input type="checkbox" name="contact_form_enabled" checked={settings?.contact_form_enabled} />
      Show contact form on the Contact page
    </label>

    <fieldset class="border border-(--color-line) p-4">
      <legend class="px-1 text-sm text-(--color-ink-soft)">Contact Page Image</legend>
      <ImagePicker
        idPrefix="contact-image"
        label="Image shown beside the contact details"
        aspect="aspect-[3/4]"
        objectPosition="object-top"
        helpText="JPG, PNG, or WebP. Max 20MB. Portrait photos work best — the image is cropped to fit, keeping the top."
      />
      <div class="mt-3">
        <label for="contact-image-alt" class="block text-sm text-(--color-ink-soft)">Image description (for screen readers)</label>
        <input id="contact-image-alt" type="text" maxlength="200" value={contactImage?.alt_text ?? ''}
          class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 text-sm focus:border-(--color-clay) focus:outline-none" />
      </div>

      <div class="mt-4">
        <div class="flex items-center justify-between">
          <label class="block text-sm text-(--color-ink-soft)">Image Focal Point</label>
          <button type="button" id="focal-reset"
            class="text-xs text-(--color-ink-soft) hover:text-(--color-clay) hover:underline">
            Reset focal point
          </button>
        </div>
        <p class="mt-1 text-xs text-(--color-ink-faint)">
          Click (or tap) the most important part of the image below. Used wherever this image is cropped on the
          Contact page — desktop, tablet, and mobile.
        </p>

        <div id="focal-wrap" class="relative mt-2 inline-block max-w-full select-none" hidden>
          <img id="focal-image" alt="" class="block max-h-96 max-w-full cursor-crosshair" />
          <div
            id="focal-marker"
            class="pointer-events-none absolute h-5 w-5 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-(--color-clay) bg-(--color-paper)/60 shadow-[0_0_0_1px_rgba(0,0,0,0.3)]"
          />
        </div>
        <p id="focal-no-image" class="mt-2 text-xs text-(--color-ink-faint)">
          Add an image above to set a focal point.
        </p>

        <div class="mt-4 max-w-md">
          <p class="text-xs text-(--color-ink-soft)">Desktop preview (approximate)</p>
          <div class="mt-1 aspect-[21/9] w-full overflow-hidden bg-(--color-paper-raised)">
            <img id="focal-hero-preview" alt="" class="h-full w-full object-cover" />
          </div>
        </div>
      </div>
      {
        !contactImageUrl && (
          <p class="mt-3 text-xs text-(--color-ink-faint)">
            No custom image is set, so the Contact page currently shows the most recent artwork
            {fallbackArtwork?.title ? ` (“${fallbackArtwork.title.trim()}”)` : ''}.
            {fallbackUrl && (
              <a href={fallbackUrl} target="_blank" rel="noopener noreferrer" class="underline">See it</a>
            )}
            Choose an image above and save to replace it. “Remove image” switches back to this default.
          </p>
        )
      }
    </fieldset>

    <fieldset class="border border-(--color-line) p-4">
      <legend class="px-1 text-sm text-(--color-ink-soft)">Default SEO (used when a page has no override)</legend>
      <div class="mt-2">
        <label for="seo_default_title" class="block text-sm text-(--color-ink-soft)">Default title</label>
        <input id="seo_default_title" name="seo_default_title" type="text" value={settings?.seo_default_title ?? ''}
          class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
      </div>
      <div class="mt-3">
        <label for="seo_default_description" class="block text-sm text-(--color-ink-soft)">Default description</label>
        <textarea id="seo_default_description" name="seo_default_description" rows="2"
          class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none">{settings?.seo_default_description ?? ''}</textarea>
      </div>
    </fieldset>

    <div class="flex items-center gap-4">
      <button type="submit"
        class="border border-(--color-ink) px-6 py-2 text-sm tracking-wide uppercase hover:bg-(--color-ink) hover:text-(--color-paper)">
        Save
      </button>
      <p id="form-status" role="status" class="text-sm"></p>
    </div>
  </form>

  <script>
    import { initImagePicker, initFocalPicker, uploadImage } from '../../../lib/admin-image-picker';

    const form = document.getElementById('settings-form') as HTMLFormElement;
    const status = document.getElementById('form-status')!;
    const altInput = document.getElementById('contact-image-alt') as HTMLInputElement;

    const existingImageId = form.dataset.contactImageId || null;
    const existingAlt = form.dataset.contactImageAlt ?? '';

    const DEFAULT_FOCAL = { x: 50, y: 0 }; // matches the column defaults — equivalent to the old fixed object-top.

    // Number(...) || fallback would wrongly replace a genuinely-saved 0
    // (the default Y, and a valid X for the image's far left edge) with the
    // fallback, since 0 is falsy — parse once and only fall back on NaN.
    function parseFocal(value: string | undefined, fallback: number): number {
      const n = Number(value);
      return Number.isFinite(n) ? n : fallback;
    }

    const contactImagePreview = document.getElementById('contact-image-preview') as HTMLImageElement;

    const focalPicker = initFocalPicker(
      {
        wrap: document.getElementById('focal-wrap')!,
        image: document.getElementById('focal-image') as HTMLImageElement,
        marker: document.getElementById('focal-marker')!,
        noImageMessage: document.getElementById('focal-no-image')!,
        heroPreview: document.getElementById('focal-hero-preview') as HTMLImageElement,
        // Keeps the picker's own small preview (the one visitors' mobile
        // crop most resembles) showing the same focal point live too.
        extraPreviews: [contactImagePreview],
      },
      {
        x: parseFocal(form.dataset.contactImageFocalX, DEFAULT_FOCAL.x),
        y: parseFocal(form.dataset.contactImageFocalY, DEFAULT_FOCAL.y),
      }
    );

    document.getElementById('focal-reset')?.addEventListener('click', () => {
      focalPicker.setPosition(DEFAULT_FOCAL.x, DEFAULT_FOCAL.y);
    });

    // Nothing is uploaded until Save — choosing a file only previews it, so
    // abandoning the page never leaves an orphaned upload behind.
    const contactPicker = initImagePicker(
      {
        fileInput: document.getElementById('contact-image-file') as HTMLInputElement,
        preview: contactImagePreview,
        placeholder: document.getElementById('contact-image-placeholder')!,
        removeButton: document.getElementById('contact-image-remove') as HTMLButtonElement,
        status: document.getElementById('contact-image-status')!,
      },
      form.dataset.contactImageUrl || null,
      // Keeps the focal picker pointed at whichever image is currently
      // effective — a newly chosen file, or none once removed.
      () => focalPicker.setImageSrc(contactPicker.hasImage() ? contactImagePreview.src : null)
    );
    focalPicker.setImageSrc(contactPicker.hasImage() ? contactImagePreview.src : null);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(form);

      const payload: Record<string, unknown> = {
        site_title: formData.get('site_title'),
        tagline: formData.get('tagline') || null,
        contact_email: formData.get('contact_email') || null,
        phone: formData.get('phone') || null,
        studio_location: formData.get('studio_location') || null,
        contact_intro: formData.get('contact_intro') || null,
        contact_form_enabled: formData.get('contact_form_enabled') === 'on',
        seo_default_title: formData.get('seo_default_title') || null,
        seo_default_description: formData.get('seo_default_description') || null,
      };

      const focalPosition = focalPicker.getPosition();
      payload.contact_image_focal_x = focalPosition.x;
      payload.contact_image_focal_y = focalPosition.y;

      status.textContent = 'Saving…';
      const imageState = contactPicker.getState();
      const alt = altInput.value.trim();
      const imageChanged = imageState.kind !== 'unchanged';

      try {
        if (imageState.kind === 'file') {
          payload.contact_image_media_id = await uploadImage(imageState.file, 'site-media', alt || 'JTP Skulptur');
        } else if (imageState.kind === 'removed') {
          // Only unlinks it: the file stays in the media library, since it
          // may be used elsewhere. The Contact page falls back to its default.
          payload.contact_image_media_id = null;
        } else if (existingImageId && alt !== existingAlt) {
          const altResponse = await fetch(`/api/admin/media/${existingImageId}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ alt_text: alt || null }),
          });
          if (!altResponse.ok) throw new Error('Could not save the image description.');
        }
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : 'Image upload failed.';
        return;
      }

      const response = await fetch('/api/admin/settings', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = (await response.json().catch(() => ({}))) as { error?: string };
      status.textContent = response.ok ? 'Saved.' : (result.error ?? 'Something went wrong.');

      // Reload after an image, alt text, or focal point change so the
      // preview, the "default image" note and the pickers' own state all
      // reflect what was just saved.
      const focalChanged =
        focalPosition.x !== parseFocal(form.dataset.contactImageFocalX, DEFAULT_FOCAL.x) ||
        focalPosition.y !== parseFocal(form.dataset.contactImageFocalY, DEFAULT_FOCAL.y);
      if (response.ok && (imageChanged || alt !== existingAlt || focalChanged)) setTimeout(() => window.location.reload(), 700);
    });
  </script>
</AdminLayout>
