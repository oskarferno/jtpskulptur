---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ImagePicker from '../../../components/admin/ImagePicker.astro';
import { publicMediaUrl } from '../../../lib/media';

const supabase = Astro.locals.supabase!;
const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/admin/exhibitions');
}

const { data: exhibition } = await supabase
  .from('exhibitions')
  .select(
    `id, slug, title, venue, city, country, start_date, end_date, intro, description, url, exhibition_type,
     published, seo_title, seo_description, cover_focal_x, cover_focal_y,
     cover_media:cover_media_id (storage_path, bucket, alt_text),
     content_image:content_image_media_id (storage_path, bucket, alt_text)`
  )
  .eq('id', id)
  .single();

if (!exhibition) {
  return Astro.redirect('/admin/exhibitions');
}

const coverImageUrl = exhibition.cover_media
  ? publicMediaUrl(exhibition.cover_media.bucket, exhibition.cover_media.storage_path)
  : null;
const contentImageUrl = exhibition.content_image
  ? publicMediaUrl(exhibition.content_image.bucket, exhibition.content_image.storage_path)
  : null;
---

<AdminLayout title={exhibition.title}>
  <form id="exhibition-form" class="max-w-xl space-y-4" data-exhibition-id={exhibition.id} data-cover-url={coverImageUrl ?? ''}
    data-focal-x={exhibition.cover_focal_x} data-focal-y={exhibition.cover_focal_y} data-content-image-url={contentImageUrl ?? ''}>
    <ImagePicker idPrefix="cover" label="Exhibition image" helpText="JPG, PNG, or WebP. Max 20MB. Shown on the Exhibitions page, this exhibition's own page, and the homepage." />

    <div>
      <label class="block text-sm text-(--color-ink-soft)">Image Focal Point</label>
      <p class="mt-1 text-xs text-(--color-ink-faint)">
        Click (or tap) the most important part of the image below. On this exhibition's own page, the image is
        cropped wide on laptop/desktop screens — this keeps that point in view instead of the automatic center crop.
      </p>

      <div id="focal-wrap" class="relative mt-2 inline-block max-w-full select-none" hidden>
        <img id="focal-image" alt="" class="block max-h-96 max-w-full cursor-crosshair" />
        <div
          id="focal-marker"
          class="pointer-events-none absolute h-5 w-5 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-(--color-clay) bg-(--color-paper)/60 shadow-[0_0_0_1px_rgba(0,0,0,0.3)]"
        />
      </div>
      <p id="focal-no-image" class="mt-2 text-xs text-(--color-ink-faint)">
        Add an exhibition image above to set a focal point.
      </p>

      <div class="mt-4 max-w-md">
        <p class="text-xs text-(--color-ink-soft)">Exhibition page preview (approximate, desktop width)</p>
        <div class="mt-1 aspect-[21/9] w-full overflow-hidden bg-(--color-paper-raised)">
          <img id="focal-hero-preview" alt="" class="h-full w-full object-cover" />
        </div>
      </div>
    </div>

    <ImagePicker idPrefix="content-image" label="Content image (optional)"
      helpText="JPG, PNG, or WebP. Max 20MB. Shown underneath the text on this exhibition's own page — the same treatment as the large image on a Journal article. Leave empty to show no content image." />

    <p class="text-xs text-(--color-ink-soft)">
      A gallery of further images beyond this one can be attached via the media library (see <a href="/admin/media" class="underline">Media</a>) and the exhibition_images table.
    </p>

    <label class="flex items-center gap-2 text-sm">
      <input type="checkbox" name="published" checked={exhibition.published} />
      Published
    </label>

    <div>
      <label for="title" class="block text-sm text-(--color-ink-soft)">Title</label>
      <input id="title" name="title" type="text" required value={exhibition.title}
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
    </div>

    <div>
      <label for="slug" class="block text-sm text-(--color-ink-soft)">Slug</label>
      <input id="slug" name="slug" type="text" value={exhibition.slug ?? ''} pattern="[a-z0-9]+(-[a-z0-9]+)*"
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
      <p class="mt-1 text-xs text-(--color-ink-soft)">Public URL: /exhibitions/{exhibition.slug ?? '(set a slug to enable the detail page)'}</p>
    </div>

    <div>
      <label for="venue" class="block text-sm text-(--color-ink-soft)">Venue</label>
      <input id="venue" name="venue" type="text" value={exhibition.venue ?? ''}
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label for="city" class="block text-sm text-(--color-ink-soft)">City</label>
        <input id="city" name="city" type="text" value={exhibition.city ?? ''}
          class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
      </div>
      <div>
        <label for="country" class="block text-sm text-(--color-ink-soft)">Country</label>
        <input id="country" name="country" type="text" value={exhibition.country ?? ''}
          class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label for="start_date" class="block text-sm text-(--color-ink-soft)">Start date</label>
        <input id="start_date" name="start_date" type="date" value={exhibition.start_date ?? ''}
          class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
      </div>
      <div>
        <label for="end_date" class="block text-sm text-(--color-ink-soft)">End date</label>
        <input id="end_date" name="end_date" type="date" value={exhibition.end_date ?? ''}
          class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
      </div>
    </div>

    <div>
      <label for="exhibition_type" class="block text-sm text-(--color-ink-soft)">Type</label>
      <input id="exhibition_type" name="exhibition_type" type="text" value={exhibition.exhibition_type ?? ''}
        placeholder="e.g. solo, group, fair"
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
    </div>

    <div>
      <label for="url" class="block text-sm text-(--color-ink-soft)">URL</label>
      <input id="url" name="url" type="url" value={exhibition.url ?? ''}
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
    </div>

    <div>
      <label for="intro" class="block text-sm text-(--color-ink-soft)">Short introduction</label>
      <textarea id="intro" name="intro" rows="2"
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none">{exhibition.intro ?? ''}</textarea>
    </div>

    <div>
      <label for="description" class="block text-sm text-(--color-ink-soft)">Description</label>
      <textarea id="description" name="description" rows="5"
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none">{exhibition.description ?? ''}</textarea>
    </div>

    <fieldset class="border border-(--color-line) p-4">
      <legend class="px-1 text-sm text-(--color-ink-soft)">SEO (optional — falls back to defaults if empty)</legend>
      <div class="mt-2">
        <label for="seo_title" class="block text-sm text-(--color-ink-soft)">SEO title</label>
        <input id="seo_title" name="seo_title" type="text" value={exhibition.seo_title ?? ''}
          class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
      </div>
      <div class="mt-3">
        <label for="seo_description" class="block text-sm text-(--color-ink-soft)">SEO description</label>
        <textarea id="seo_description" name="seo_description" rows="2"
          class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none">{exhibition.seo_description ?? ''}</textarea>
      </div>
    </fieldset>

    <div class="flex items-center gap-4">
      <button type="submit"
        class="border border-(--color-ink) px-6 py-2 text-sm tracking-wide uppercase hover:bg-(--color-ink) hover:text-(--color-paper)">
        Save
      </button>
      <button type="button" id="delete-button" class="text-sm text-red-700 hover:underline">Delete</button>
      <p id="form-status" role="status" class="text-sm"></p>
    </div>
  </form>

  <script>
    import { initImagePicker, initFocalPicker, uploadImage } from '../../../lib/admin-image-picker';

    const form = document.getElementById('exhibition-form') as HTMLFormElement;
    const status = document.getElementById('form-status')!;
    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const deleteButton = document.getElementById('delete-button');
    const exhibitionId = form.dataset.exhibitionId;

    const focalPicker = initFocalPicker(
      {
        wrap: document.getElementById('focal-wrap')!,
        image: document.getElementById('focal-image') as HTMLImageElement,
        marker: document.getElementById('focal-marker')!,
        noImageMessage: document.getElementById('focal-no-image')!,
        heroPreview: document.getElementById('focal-hero-preview') as HTMLImageElement,
      },
      { x: Number(form.dataset.focalX) || 50, y: Number(form.dataset.focalY) || 50 }
    );

    const coverPicker = initImagePicker(
      {
        fileInput: document.getElementById('cover-file') as HTMLInputElement,
        preview: document.getElementById('cover-preview') as HTMLImageElement,
        placeholder: document.getElementById('cover-placeholder')!,
        removeButton: document.getElementById('cover-remove') as HTMLButtonElement,
        status: document.getElementById('cover-status')!,
      },
      form.dataset.coverUrl || null,
      // Keeps the focal picker pointed at whichever image is currently
      // effective — a newly chosen file, or none once removed.
      () => focalPicker.setImageSrc(coverPicker.hasImage() ? (document.getElementById('cover-preview') as HTMLImageElement).src : null)
    );
    focalPicker.setImageSrc(coverPicker.hasImage() ? (document.getElementById('cover-preview') as HTMLImageElement).src : null);

    const contentImagePicker = initImagePicker(
      {
        fileInput: document.getElementById('content-image-file') as HTMLInputElement,
        preview: document.getElementById('content-image-preview') as HTMLImageElement,
        placeholder: document.getElementById('content-image-placeholder')!,
        removeButton: document.getElementById('content-image-remove') as HTMLButtonElement,
        status: document.getElementById('content-image-status')!,
      },
      form.dataset.contentImageUrl || null
    );

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(form);

      const payload: Record<string, unknown> = {
        title: formData.get('title'),
        slug: formData.get('slug') || null,
        venue: formData.get('venue') || null,
        city: formData.get('city') || null,
        country: formData.get('country') || null,
        start_date: formData.get('start_date') || null,
        end_date: formData.get('end_date') || null,
        exhibition_type: formData.get('exhibition_type') || null,
        url: formData.get('url') || null,
        intro: formData.get('intro') || null,
        description: formData.get('description') || null,
        seo_title: formData.get('seo_title') || null,
        seo_description: formData.get('seo_description') || null,
        published: formData.get('published') === 'on',
      };

      const focalPosition = focalPicker.getPosition();
      payload.cover_focal_x = focalPosition.x;
      payload.cover_focal_y = focalPosition.y;

      submitButton.disabled = true;
      const title = formData.get('title') as string;
      const coverState = coverPicker.getState();
      const contentImageState = contentImagePicker.getState();

      try {
        if (coverState.kind === 'file') {
          status.textContent = 'Uploading image…';
          payload.cover_media_id = await uploadImage(coverState.file, 'site-media', title);
        } else if (coverState.kind === 'removed') {
          payload.cover_media_id = null;
        }
        if (contentImageState.kind === 'file') {
          status.textContent = 'Uploading content image…';
          payload.content_image_media_id = await uploadImage(contentImageState.file, 'site-media', title);
        } else if (contentImageState.kind === 'removed') {
          payload.content_image_media_id = null;
        }
      } catch (err) {
        status.textContent = err instanceof Error ? err.message : 'Image upload failed.';
        submitButton.disabled = false;
        return;
      }

      status.textContent = 'Saving…';
      const response = await fetch(`/api/admin/exhibitions/${exhibitionId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = (await response.json().catch(() => ({}))) as { error?: string };
      status.textContent = response.ok ? 'Saved.' : (result.error ?? 'Something went wrong.');
      submitButton.disabled = false;
      if (response.ok) {
        window.location.reload();
      }
    });

    deleteButton?.addEventListener('click', async () => {
      if (!confirm('Delete this exhibition permanently?')) return;
      const response = await fetch(`/api/admin/exhibitions/${exhibitionId}`, { method: 'DELETE' });
      if (response.ok) {
        window.location.href = '/admin/exhibitions';
      } else {
        status.textContent = 'Could not delete.';
      }
    });
  </script>
</AdminLayout>
