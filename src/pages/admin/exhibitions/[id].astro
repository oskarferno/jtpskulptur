---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { publicMediaUrl } from '../../../lib/media';

const supabase = Astro.locals.supabase!;
const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/admin/exhibitions');
}

const { data: exhibition } = await supabase
  .from('exhibitions')
  .select(
    `id, slug, title, venue, city, country, start_date, end_date, intro, description, url, exhibition_type,
     published, seo_title, seo_description,
     cover_media:cover_media_id (storage_path, bucket, alt_text)`
  )
  .eq('id', id)
  .single();

if (!exhibition) {
  return Astro.redirect('/admin/exhibitions');
}
---

<AdminLayout title={exhibition.title}>
  <form id="exhibition-form" class="max-w-xl space-y-4" data-exhibition-id={exhibition.id}>
    {exhibition.cover_media && (
      <img
        src={publicMediaUrl(exhibition.cover_media.bucket, exhibition.cover_media.storage_path)}
        alt=""
        class="aspect-square w-40 border border-(--color-line) object-cover"
      />
    )}
    <p class="text-xs text-(--color-ink-soft)">
      Cover and gallery images are attached via the media library (see <a href="/admin/media" class="underline">Media</a>) and the exhibition_images table.
    </p>

    <label class="flex items-center gap-2 text-sm">
      <input type="checkbox" name="published" checked={exhibition.published} />
      Published
    </label>

    <div>
      <label for="title" class="block text-sm text-(--color-ink-soft)">Title</label>
      <input id="title" name="title" type="text" required value={exhibition.title}
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
    </div>

    <div>
      <label for="slug" class="block text-sm text-(--color-ink-soft)">Slug</label>
      <input id="slug" name="slug" type="text" value={exhibition.slug ?? ''} pattern="[a-z0-9]+(-[a-z0-9]+)*"
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
      <p class="mt-1 text-xs text-(--color-ink-soft)">Public URL: /exhibitions/{exhibition.slug ?? '(set a slug to enable the detail page)'}</p>
    </div>

    <div>
      <label for="venue" class="block text-sm text-(--color-ink-soft)">Venue</label>
      <input id="venue" name="venue" type="text" value={exhibition.venue ?? ''}
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label for="city" class="block text-sm text-(--color-ink-soft)">City</label>
        <input id="city" name="city" type="text" value={exhibition.city ?? ''}
          class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
      </div>
      <div>
        <label for="country" class="block text-sm text-(--color-ink-soft)">Country</label>
        <input id="country" name="country" type="text" value={exhibition.country ?? ''}
          class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label for="start_date" class="block text-sm text-(--color-ink-soft)">Start date</label>
        <input id="start_date" name="start_date" type="date" value={exhibition.start_date ?? ''}
          class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
      </div>
      <div>
        <label for="end_date" class="block text-sm text-(--color-ink-soft)">End date</label>
        <input id="end_date" name="end_date" type="date" value={exhibition.end_date ?? ''}
          class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
      </div>
    </div>

    <div>
      <label for="exhibition_type" class="block text-sm text-(--color-ink-soft)">Type</label>
      <input id="exhibition_type" name="exhibition_type" type="text" value={exhibition.exhibition_type ?? ''}
        placeholder="e.g. solo, group, fair"
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
    </div>

    <div>
      <label for="url" class="block text-sm text-(--color-ink-soft)">URL</label>
      <input id="url" name="url" type="url" value={exhibition.url ?? ''}
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
    </div>

    <div>
      <label for="intro" class="block text-sm text-(--color-ink-soft)">Short introduction</label>
      <textarea id="intro" name="intro" rows="2"
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none">{exhibition.intro ?? ''}</textarea>
    </div>

    <div>
      <label for="description" class="block text-sm text-(--color-ink-soft)">Description</label>
      <textarea id="description" name="description" rows="5"
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none">{exhibition.description ?? ''}</textarea>
    </div>

    <fieldset class="border border-(--color-line) p-4">
      <legend class="px-1 text-sm text-(--color-ink-soft)">SEO (optional — falls back to defaults if empty)</legend>
      <div class="mt-2">
        <label for="seo_title" class="block text-sm text-(--color-ink-soft)">SEO title</label>
        <input id="seo_title" name="seo_title" type="text" value={exhibition.seo_title ?? ''}
          class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
      </div>
      <div class="mt-3">
        <label for="seo_description" class="block text-sm text-(--color-ink-soft)">SEO description</label>
        <textarea id="seo_description" name="seo_description" rows="2"
          class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none">{exhibition.seo_description ?? ''}</textarea>
      </div>
    </fieldset>

    <div class="flex items-center gap-4">
      <button type="submit"
        class="border border-(--color-ink) px-6 py-2 text-sm tracking-wide uppercase hover:bg-(--color-ink) hover:text-(--color-paper)">
        Save
      </button>
      <button type="button" id="delete-button" class="text-sm text-red-700 hover:underline">Delete</button>
      <p id="form-status" role="status" class="text-sm"></p>
    </div>
  </form>

  <script>
    const form = document.getElementById('exhibition-form') as HTMLFormElement;
    const status = document.getElementById('form-status')!;
    const deleteButton = document.getElementById('delete-button');
    const exhibitionId = form.dataset.exhibitionId;

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(form);

      const payload = {
        title: formData.get('title'),
        slug: formData.get('slug') || null,
        venue: formData.get('venue') || null,
        city: formData.get('city') || null,
        country: formData.get('country') || null,
        start_date: formData.get('start_date') || null,
        end_date: formData.get('end_date') || null,
        exhibition_type: formData.get('exhibition_type') || null,
        url: formData.get('url') || null,
        intro: formData.get('intro') || null,
        description: formData.get('description') || null,
        seo_title: formData.get('seo_title') || null,
        seo_description: formData.get('seo_description') || null,
        published: formData.get('published') === 'on',
      };

      status.textContent = 'Saving…';
      const response = await fetch(`/api/admin/exhibitions/${exhibitionId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = (await response.json().catch(() => ({}))) as { error?: string };
      status.textContent = response.ok ? 'Saved.' : (result.error ?? 'Something went wrong.');
    });

    deleteButton?.addEventListener('click', async () => {
      if (!confirm('Delete this exhibition permanently?')) return;
      const response = await fetch(`/api/admin/exhibitions/${exhibitionId}`, { method: 'DELETE' });
      if (response.ok) {
        window.location.href = '/admin/exhibitions';
      } else {
        status.textContent = 'Could not delete.';
      }
    });
  </script>
</AdminLayout>
