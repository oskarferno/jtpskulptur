---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="New vendor">
  <form id="new-vendor-form" class="max-w-md space-y-4">
    <div>
      <label for="name" class="block text-sm text-(--color-ink-soft)">Name</label>
      <input id="name" name="name" type="text" required
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
    </div>
    <button type="submit"
      class="border border-(--color-ink) px-6 py-2 text-sm tracking-wide uppercase hover:bg-(--color-ink) hover:text-(--color-paper)">
      Create
    </button>
    <p id="form-status" role="status" class="text-sm"></p>
  </form>

  <script>
    const form = document.getElementById('new-vendor-form') as HTMLFormElement;
    const status = document.getElementById('form-status')!;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(form);
      status.textContent = 'Creating…';

      const response = await fetch('/api/admin/vendors', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: formData.get('name') }),
      });
      const result = (await response.json().catch(() => ({}))) as { vendor?: { id: string }; error?: string };

      if (response.ok && result.vendor) {
        window.location.href = `/admin/vendors/${result.vendor.id}`;
      } else {
        status.textContent = result.error ?? 'Something went wrong.';
      }
    });
  </script>
</AdminLayout>
