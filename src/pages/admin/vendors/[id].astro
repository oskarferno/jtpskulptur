---
import AdminLayout from '../../../layouts/AdminLayout.astro';

const supabase = Astro.locals.supabase!;
const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/admin/vendors');
}

const { data: vendor } = await supabase
  .from('vendors')
  .select('id, name, contact_email, notification_email, active')
  .eq('id', id)
  .single();

if (!vendor) {
  return Astro.redirect('/admin/vendors');
}

const { data: hasLogin } = await supabase.from('profiles').select('id').eq('vendor_id', id).maybeSingle();
---

<AdminLayout title={vendor.name}>
  {!hasLogin && (
    <p class="mb-6 border border-(--color-line) bg-(--color-paper-raised) px-4 py-3 text-sm text-(--color-ink-soft)">
      No login account exists for this vendor yet. Creating one requires a manual step in the Supabase dashboard
      (Authentication → add user, then a matching <code>profiles</code> row with <code>role='vendor'</code> and
      <code>vendor_id='{vendor.id}'</code>) — ask me when you're ready to set this up.
    </p>
  )}

  <form id="vendor-form" class="max-w-md space-y-4" data-vendor-id={vendor.id}>
    <label class="flex items-center gap-2 text-sm">
      <input type="checkbox" name="active" checked={vendor.active} />
      Active
    </label>

    <div>
      <label for="name" class="block text-sm text-(--color-ink-soft)">Name</label>
      <input id="name" name="name" type="text" required value={vendor.name}
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
    </div>
    <div>
      <label for="contact_email" class="block text-sm text-(--color-ink-soft)">Contact email</label>
      <input id="contact_email" name="contact_email" type="email" value={vendor.contact_email ?? ''}
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
    </div>
    <div>
      <label for="notification_email" class="block text-sm text-(--color-ink-soft)">Notification email</label>
      <input id="notification_email" name="notification_email" type="email" value={vendor.notification_email ?? ''}
        class="mt-1 w-full border border-(--color-line) bg-transparent px-3 py-2 focus:border-(--color-clay) focus:outline-none" />
      <p class="mt-1 text-xs text-(--color-ink-soft)">Where "new paid order" notifications are sent. Can differ from the contact email.</p>
    </div>

    <div class="flex items-center gap-4">
      <button type="submit"
        class="border border-(--color-ink) px-6 py-2 text-sm tracking-wide uppercase transition-colors hover:bg-(--color-ink) hover:text-(--color-paper)">
        Save
      </button>
      <p id="form-status" role="status" class="text-sm"></p>
    </div>
  </form>

  <script>
    const form = document.getElementById('vendor-form') as HTMLFormElement;
    const status = document.getElementById('form-status')!;
    const vendorId = form.dataset.vendorId;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(form);

      status.textContent = 'Saving…';
      const response = await fetch(`/api/admin/vendors/${vendorId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: formData.get('name'),
          contact_email: formData.get('contact_email') || null,
          notification_email: formData.get('notification_email') || null,
          active: formData.get('active') === 'on',
        }),
      });
      const result = (await response.json().catch(() => ({}))) as { error?: string };
      status.textContent = response.ok ? 'Saved.' : (result.error ?? 'Something went wrong.');
    });
  </script>
</AdminLayout>
