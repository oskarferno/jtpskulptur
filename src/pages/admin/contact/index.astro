---
import AdminLayout from '../../../layouts/AdminLayout.astro';

const supabase = Astro.locals.supabase!;

const { data: messages } = await supabase
  .from('contact_messages')
  .select('id, name, email, subject, message, read, created_at, enquiry_type, artwork:artwork_id (slug, title)')
  .order('created_at', { ascending: false });
---

<AdminLayout title="Contact messages">
  {
    messages && messages.length > 0 ? (
      <ul class="space-y-4">
        {messages.map((m) => (
          <li class="message-row border border-(--color-line) p-4" data-message-id={m.id} data-read={m.read ? 'true' : 'false'}>
            <div class="flex items-center justify-between text-sm text-(--color-ink-soft)">
              <span>{new Date(m.created_at).toLocaleString()}</span>
              <span class="unread-badge text-(--color-clay)" hidden={m.read}>unread</span>
            </div>
            <p class="mt-2 font-medium">{m.name} &lt;{m.email}&gt;</p>
            {m.subject && <p class="text-sm text-(--color-ink-soft)">{m.subject}</p>}
            {m.enquiry_type === 'artwork' && (
              <p class="mt-1 text-sm text-(--color-clay)">
                Artwork:{' '}
                {m.artwork ? (
                  <a href={`/portfolio/${m.artwork.slug}`} target="_blank" rel="noopener noreferrer" class="hover:underline">
                    {m.artwork.title}
                  </a>
                ) : (
                  <span class="text-(--color-ink-faint)">(artwork no longer exists)</span>
                )}
              </p>
            )}
            <p class="mt-2 whitespace-pre-line">{m.message}</p>
            <div class="mt-4 flex gap-4 text-xs uppercase tracking-[0.04em]">
              <button type="button" class="toggle-read-btn text-(--color-ink-soft) hover:text-(--color-clay)">
                {m.read ? 'Mark as unread' : 'Mark as read'}
              </button>
              <button type="button" class="delete-message-btn text-(--color-ink-faint) hover:text-red-700">Delete</button>
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-(--color-ink-soft)">No messages yet.</p>
    )
  }

  <script>
    document.querySelectorAll<HTMLElement>('.message-row').forEach((row) => {
      const id = row.dataset.messageId;
      const badge = row.querySelector<HTMLElement>('.unread-badge')!;
      const toggleBtn = row.querySelector<HTMLButtonElement>('.toggle-read-btn')!;
      const deleteBtn = row.querySelector<HTMLButtonElement>('.delete-message-btn')!;

      toggleBtn.addEventListener('click', async () => {
        const markRead = row.dataset.read !== 'true';
        toggleBtn.disabled = true;
        const response = await fetch(`/api/admin/contact/${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ read: markRead }),
        });
        toggleBtn.disabled = false;
        if (!response.ok) {
          const result = (await response.json().catch(() => ({}))) as { error?: string };
          alert(result.error ?? 'Could not update.');
          return;
        }
        row.dataset.read = markRead ? 'true' : 'false';
        badge.hidden = markRead;
        toggleBtn.textContent = markRead ? 'Mark as unread' : 'Mark as read';
      });

      deleteBtn.addEventListener('click', async () => {
        if (!confirm('Delete this message? This cannot be undone.')) return;
        const response = await fetch(`/api/admin/contact/${id}`, { method: 'DELETE' });
        if (!response.ok) {
          const result = (await response.json().catch(() => ({}))) as { error?: string };
          alert(result.error ?? 'Could not delete.');
          return;
        }
        row.remove();
        if (document.querySelectorAll('.message-row').length === 0) window.location.reload();
      });
    });
  </script>
</AdminLayout>
