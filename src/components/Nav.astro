---
import { getSupabaseClient } from '../lib/supabase';

const { pathname } = Astro.url;
const supabase = getSupabaseClient();

const [{ count: exhibitionCount }, { count: postCount }] = await Promise.all([
  supabase.from('exhibitions').select('id', { count: 'exact', head: true }).eq('published', true),
  supabase.from('posts').select('id', { count: 'exact', head: true }).eq('published', true),
]);

const links = [
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/about', label: 'About' },
  ...(exhibitionCount ? [{ href: '/exhibitions', label: 'Exhibitions' }] : []),
  ...(postCount ? [{ href: '/journal', label: 'Journal' }] : []),
  { href: '/contact', label: 'Contact' },
];

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header class="sticky top-0 z-40 border-b border-(--color-line) bg-(--color-paper)/90 backdrop-blur-sm">
  <div class="mx-auto flex max-w-(--measure-full) flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-4 sm:flex-nowrap sm:px-8 sm:py-5">
    <a href="/" class="flex-shrink-0">
      <img
        src="/jtp-skulptur-logo.png"
        alt="JTP Skulptur"
        width="1681"
        height="150"
        class="h-5 w-auto sm:h-7"
      />
    </a>
    <nav aria-label="Main">
      <ul class="flex flex-wrap gap-x-4 gap-y-1 text-xs tracking-[0.06em] uppercase sm:gap-x-8 sm:text-sm">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'transition-colors hover:text-(--color-clay)',
                  isActive(link.href) ? 'text-(--color-clay)' : 'text-(--color-ink-soft)',
                ]}
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
