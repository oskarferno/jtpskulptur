---
import { getSupabaseClient } from '../lib/supabase';

const { pathname } = Astro.url;
const supabase = getSupabaseClient();

const [{ count: exhibitionCount }, { count: postCount }] = await Promise.all([
  supabase.from('exhibitions').select('id', { count: 'exact', head: true }).eq('published', true),
  supabase.from('posts').select('id', { count: 'exact', head: true }).eq('published', true),
]);

const links = [
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/about', label: 'About' },
  ...(exhibitionCount ? [{ href: '/exhibitions', label: 'Exhibitions' }] : []),
  ...(postCount ? [{ href: '/journal', label: 'Journal' }] : []),
  { href: '/contact', label: 'Contact' },
];

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header id="site-header" class="sticky top-0 z-40 border-b border-(--color-line) bg-(--color-paper)/90 backdrop-blur-sm">
  <div class="mx-auto flex max-w-(--measure-full) items-center justify-between px-4 py-4 sm:px-8 sm:py-5">
    <a href="/" class="flex-shrink-0">
      <img
        src="/jtp-skulptur-logo.png"
        alt="JTP Skulptur"
        width="1681"
        height="150"
        class="h-4 w-auto sm:h-5 lg:h-6"
      />
    </a>

    <nav aria-label="Main" class="nav:block hidden">
      <ul class="flex gap-x-8 text-sm tracking-[0.02em]">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'transition-colors hover:text-(--color-clay)',
                  isActive(link.href) ? 'text-(--color-clay)' : 'text-(--color-ink-soft)',
                ]}
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      type="button"
      id="nav-toggle"
      class="group nav:hidden -mr-2.5 flex h-11 w-11 shrink-0 items-center justify-center"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <span class="relative flex h-[13px] w-5 flex-col justify-between">
        <span class="block h-px w-full origin-center bg-current transition-transform duration-200 ease-out group-aria-expanded:translate-y-[6px] group-aria-expanded:rotate-45"></span>
        <span class="block h-px w-full origin-center bg-current transition-transform duration-200 ease-out group-aria-expanded:-translate-y-[6px] group-aria-expanded:-rotate-45"></span>
      </span>
    </button>
  </div>
</header>

<nav
  id="mobile-menu"
  aria-label="Mobile"
  hidden
  class="nav:hidden fixed inset-x-0 bottom-0 z-30 overflow-y-auto bg-(--color-paper) px-4 pt-10 pb-10 sm:px-8"
>
  <ul class="flex flex-col gap-5 sm:gap-6">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'font-display block text-4xl leading-none transition-colors sm:text-5xl',
              isActive(link.href) ? 'text-(--color-clay)' : 'text-(--color-ink)',
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  import { initNav } from '../lib/nav';
  initNav();
</script>
