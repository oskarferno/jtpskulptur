---
import { getSupabaseClient } from '../lib/supabase';

const supabase = getSupabaseClient();

const [{ data: socialLinks }, { data: settings }] = await Promise.all([
  supabase.from('social_links').select('id, label, url').eq('published', true).order('display_order'),
  supabase.from('site_settings').select('contact_email, tagline').single(),
]);
---

<footer class="border-t border-(--color-line)">
  <div class="mx-auto max-w-(--measure-full) px-4 py-12 sm:px-8 sm:py-16">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <img
          src="/jtp-skulptur-logo.png"
          alt="JTP Skulptur"
          width="1681"
          height="150"
          class="jtp-logo"
        />
        {settings?.tagline && <p class="caption mt-3">{settings.tagline}</p>}
      </div>
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-(--color-ink-soft)">
        {settings?.contact_email && (
          <li>
            <a href={`mailto:${settings.contact_email}`} class="hover:text-(--color-clay)">
              {settings.contact_email}
            </a>
          </li>
        )}
        {socialLinks?.map((link) => (
          <li>
            <a href={link.url} target="_blank" rel="noopener noreferrer" class="hover:text-(--color-clay)">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <p class="caption mt-12">&copy; {new Date().getFullYear()} JTP Skulptur</p>
  </div>
</footer>
