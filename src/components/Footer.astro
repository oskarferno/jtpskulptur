---
import { getPublicNavLinks, LEGAL_LINKS, type NavCounts } from '../lib/nav-links';
import Logo from './Logo.astro';

interface SocialLink {
  id: string;
  label: string;
  url: string;
}

interface Props extends NavCounts {
  socialLinks: SocialLink[] | null;
  settings: { contact_email: string | null; tagline: string | null } | null;
  analyticsEnabled?: boolean;
}

const { socialLinks, settings, exhibitionCount, postCount, shopItemCount, analyticsEnabled = false } = Astro.props;
const { pathname } = Astro.url;

const links = getPublicNavLinks({ exhibitionCount, postCount, shopItemCount });

function isActive(href: string) {
  return pathname.startsWith(href);
}
---

<footer class="border-t border-(--color-line)">
  <div class="mx-auto max-w-(--measure-full) px-4 py-12 sm:px-8 sm:py-16">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <Logo linked={false} />
        {settings?.tagline && <p class="caption mt-3">{settings.tagline}</p>}
      </div>

      <nav aria-label="Footer">
        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm sm:justify-end">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class:list={[
                    'transition-colors hover:text-(--color-clay)',
                    isActive(link.href) ? 'text-(--color-clay)' : 'text-(--color-ink-soft)',
                  ]}
                  aria-current={isActive(link.href) ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="mt-10 flex flex-col gap-8 border-t border-(--color-line) pt-8 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-sm">
        <p class="caption">Newsletter</p>
        <form id="newsletter-form" class="mt-3 flex gap-2">
          <input type="text" name="company" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <input type="hidden" name="rendered_at" value={Date.now()} />
          <input type="hidden" name="source" value="footer" />
          <label class="sr-only" for="newsletter-email">Email</label>
          <input
            id="newsletter-email"
            name="email"
            type="email"
            required
            placeholder="Your email"
            class="w-full min-w-0 border border-(--color-line) bg-transparent px-3 py-2 text-sm focus:border-(--color-clay)"
          />
          <button
            type="submit"
            class="flex-shrink-0 border border-(--color-ink) px-4 py-2 text-sm uppercase tracking-[0.04em] transition-colors hover:bg-(--color-ink) hover:text-(--color-paper)"
          >
            Subscribe
          </button>
        </form>
        <p id="newsletter-status" role="status" class="mt-2 text-sm text-(--color-ink-soft)"></p>
      </div>

      {(settings?.contact_email || (socialLinks && socialLinks.length > 0)) && (
        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-(--color-ink-soft) sm:justify-end">
          {settings?.contact_email && (
            <li>
              <a href={`mailto:${settings.contact_email}`} class="hover:text-(--color-clay)">
                {settings.contact_email}
              </a>
            </li>
          )}
          {socialLinks?.map((link) => (
            <li>
              <a href={link.url} target="_blank" rel="noopener noreferrer" class="hover:text-(--color-clay)">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <div class="mt-10 flex flex-col-reverse gap-4 border-t border-(--color-line) pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="caption">&copy; {new Date().getFullYear()} JTP Skulptur</p>

      <nav aria-label="Legal">
        <ul class="flex flex-wrap gap-x-5 gap-y-2 text-xs tracking-[0.02em] text-(--color-ink-faint)">
          {
            LEGAL_LINKS.map((link) => (
              <li>
                <a href={link.href} class="hover:text-(--color-clay)" aria-current={isActive(link.href) ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            ))
          }
          {
            analyticsEnabled && (
              <li>
                <button type="button" data-cookie-settings class="hover:text-(--color-clay)">
                  Cookie settings
                </button>
              </li>
            )
          }
        </ul>
      </nav>
    </div>
  </div>

  <script>
    const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
    const status = document.getElementById('newsletter-status');

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!status) return;
      status.textContent = 'Subscribing…';
      const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (submitButton) submitButton.disabled = true;

      try {
        const response = await fetch('/api/newsletter/subscribe', { method: 'POST', body: new FormData(form) });
        const result = (await response.json().catch(() => ({}))) as { ok?: boolean; error?: string };
        if (response.ok && result.ok) {
          status.textContent = 'Almost there — check your email to confirm.';
          form.reset();
        } else {
          status.textContent = result.error ?? 'Something went wrong. Please try again.';
        }
      } catch {
        status.textContent = 'Something went wrong. Please try again.';
      } finally {
        if (submitButton) submitButton.disabled = false;
      }
    });
  </script>
</footer>
